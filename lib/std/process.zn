use std.alloc;
use std.string;
use std.collections.list;
use std.io;
use std.env;
use std.thread;
use std.c.types;
use std.c.stdlib;
use std.c.string;
use std.c.errno;

@os[windows] {
  use std.c.windows.windef;
  use std.c.windows.winbase;
  use std.c.windows.fileapi;
  use std.c.windows.consoleapi;
  use std.c.windows.processthreadsapi;
  use std.c.windows.synchapi;
} else {
  use std.c.posix.unistd;
  use std.c.posix.wait;
  use std.c.posix.signal;
  use std.c.posix.fcntl;
}

extern let __zeen_argc: i32;
extern let __zeen_argv: [*][*]char;

/// OS process: arguments, working directory and exit.
pub struct Process {
  /// Number of process arguments, including the executable path.
  pub fn args_count() i32 {
    return __zeen_argc;
  }

  /// Owned copy of the process arguments.
  pub fn args() List[String] {
    let out = List#[String].new();

    let i: i32 = 0;
    while (i < __zeen_argc) {
      out.push(String.from_cstr(__zeen_argv[@as(usize, i)]));
      i += 1;
    }

    return out;
  }

  /// Zero-copy iterator over the arguments. Yields immutable slices
  /// borrowed from the OS, do not modify them.
  pub fn args_iter() ArgsIter {
    return ArgsIter.new();
  }

  /// Terminate the process with the given exit code.
  pub fn exit(code: i32) never {
    return exit(@as(c_int, code));
  }

  /// Current working directory.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.NotFound
  /// * IoErrorKind.Uncategorized
  pub fn cwd() Result[String, IoError] {
    @os[windows] {
      let buf = Allocator.alloc(4096);
      let n = GetCurrentDirectoryA(4096, @as([*]char, buf));

      if (n == 0) {
        Allocator.dealloc(buf);
        return Result.Err(IoError.last_os_error());
      };

      let out = String.from_cstr(@as([*]const char, buf));
      Allocator.dealloc(buf);
      return Result.Ok(out);
    } else {
      let buf = Allocator.alloc(4096);
      let res = getcwd(@as([*]char, buf), 4096);

      if (@as(*void, res) == nullptr) {
        Allocator.dealloc(buf);
        return Result.Err(IoError.last_os_error());
      };

      let out = String.from_cstr(@as([*]const char, buf));
      Allocator.dealloc(buf);
      return Result.Ok(out);
    }
  }
}

/// Borrowed view over the process arguments, no allocation.
pub struct ArgsIter {
  index: i32,

  pub fn new() Self {
    return ArgsIter { .index = 0 };
  }
}

implement Iterator : ArgsIter {
  pub fn next(*self) Option[[]const char] {
    let at = @as(usize, self.index);

    if (self.index >= __zeen_argc) {
      return Option.None;
    };

    self.index += 1;

    let len = strlen(@as([*]const char, __zeen_argv[at]));
    return Option.Some(__zeen_argv[at][0..@as(usize, len)]);
  }
}

/// Standard stream configuration for a child process.
pub enum Stdio {
  Piped,
  Inherit,
  Null,
}

/// Termination report of a child process.
pub struct ExitStatus {
  pub exit_code: i32,
  pub term_signal: i32,

  /// True when the process exited with code zero.
  pub fn success(*const self) bool {
    return self.term_signal == 0 && self.exit_code == 0;
  }

  /// Exit code, `None` when killed by a signal.
  pub fn code(*const self) Option[i32] {
    if (self.term_signal != 0) {
      return Option.None;
    };
    return Option.Some(self.exit_code);
  }

  /// Killing signal number, `None` on normal exit.
  pub fn signal(*const self) Option[i32] {
    if (self.term_signal == 0) {
      return Option.None;
    };
    return Option.Some(self.term_signal);
  }
}

/// Captured output of a finished child process.
pub struct Output {
  pub status: ExitStatus,
  pub stdout: String,
  pub stderr: String,
}

/// Owned read end of a child stdio pipe. Closes itself on drop.
pub struct PipeReader {
  pub fd: c_int,
  pub handle: *void,

  /// Read everything to EOF, appending to `out`. Returns bytes read.
  pub fn read_to_string(*self, out: *String) Result[usize, IoError] {
    @os[windows] {
      return read_handle_to_string(self.handle, out);
    } else {
      return read_fd_to_string(self.fd, out);
    }
  }
}

implement Drop : PipeReader {
  fn drop(self) {
    @os[windows] {
      if (self.handle != nullptr) {
        let _ = CloseHandle(self.handle);
      };
    } else {
      if (self.fd >= 0) {
        let _ = close(self.fd);
      };
    }
  }
}

/// Owned write end of a child stdio pipe. Closes itself on drop.
pub struct PipeWriter {
  pub fd: c_int,
  pub handle: *void,

  /// Write the whole buffer, retrying short writes.
  pub fn write_all(*self, buf: []const char) Result[void, IoError] {
    @os[windows] {
      return write_handle_all(self.handle, buf);
    } else {
      return write_fd_all(self.fd, buf);
    }
  }
}

implement Drop : PipeWriter {
  fn drop(self) {
    @os[windows] {
      if (self.handle != nullptr) {
        let _ = CloseHandle(self.handle);
      };
    } else {
      if (self.fd >= 0) {
        let _ = close(self.fd);
      };
    }
  }
}

/// A running or finished child process. Pipes and handles close on drop;
/// call `wait` to collect the exit status and avoid zombies.
pub struct Child {
  pub pid: i32,
  pub handle: *void,
  pub in_fd: c_int,
  pub out_fd: c_int,
  pub err_fd: c_int,
  pub win_in: *void,
  pub win_out: *void,
  pub win_err: *void,

  /// Process id.
  pub fn id(*const self) i32 {
    return self.pid;
  }

  /// Take the piped stdin writer, `None` unless `stdin(Stdio.Piped)`.
  pub fn take_stdin(*self) Option[PipeWriter] {
    @os[windows] {
      if (self.win_in == nullptr) {
        return Option.None;
      };
      let handle = self.win_in;
      self.win_in = nullptr;
      return Option.Some(PipeWriter { .fd = -1, .handle = handle });
    } else {
      if (self.in_fd < 0) {
        return Option.None;
      };
      let fd = self.in_fd;
      self.in_fd = -1;
      return Option.Some(PipeWriter { .fd = fd, .handle = nullptr });
    }
  }

  /// Take the piped stdout reader, `None` unless `stdout(Stdio.Piped)`.
  pub fn take_stdout(*self) Option[PipeReader] {
    @os[windows] {
      if (self.win_out == nullptr) {
        return Option.None;
      };
      let handle = self.win_out;
      self.win_out = nullptr;
      return Option.Some(PipeReader { .fd = -1, .handle = handle });
    } else {
      if (self.out_fd < 0) {
        return Option.None;
      };
      let fd = self.out_fd;
      self.out_fd = -1;
      return Option.Some(PipeReader { .fd = fd, .handle = nullptr });
    }
  }

  /// Take the piped stderr reader, `None` unless `stderr(Stdio.Piped)`.
  pub fn take_stderr(*self) Option[PipeReader] {
    @os[windows] {
      if (self.win_err == nullptr) {
        return Option.None;
      };
      let handle = self.win_err;
      self.win_err = nullptr;
      return Option.Some(PipeReader { .fd = -1, .handle = handle });
    } else {
      if (self.err_fd < 0) {
        return Option.None;
      };
      let fd = self.err_fd;
      self.err_fd = -1;
      return Option.Some(PipeReader { .fd = fd, .handle = nullptr });
    }
  }

  /// Wait for the child to finish, reporting how it terminated.
  pub fn wait(*self) Result[ExitStatus, IoError] {
    @os[windows] {
      let code: WinDWORD = 0;
      let r = WaitForSingleObject(self.handle, INFINITE);
      if (r == WAIT_FAILED) {
        return Result.Err(IoError.last_os_error());
      };
      if (GetExitCodeProcess(self.handle, &code) == WinFALSE) {
        return Result.Err(IoError.last_os_error());
      };
      return Result.Ok(ExitStatus { .exit_code = @as(i32, code), .term_signal = 0 });
    } else {
      let status: c_int = 0;
      while (true) {
        let r = waitpid(@as(c_pid_t, self.pid), &status, 0);
        if (r >= 0) {
          break;
        };
        let err_slot = __errno_location();
        if (*err_slot != EINTR) {
          return Result.Err(IoError.last_os_error());
        };
      };
      return Result.Ok(decode_status(status));
    }
  }

  /// Poll the child without blocking, `None` while it still runs.
  pub fn try_wait(*self) Result[Option[ExitStatus], IoError] {
    @os[windows] {
      let code: WinDWORD = 0;
      let r = WaitForSingleObject(self.handle, 0);
      if (r == WAIT_FAILED) {
        return Result.Err(IoError.last_os_error());
      };
      if (r == WAIT_TIMEOUT) {
        let idle: Option[ExitStatus] = Option.None;
        return Result.Ok(idle);
      };
      if (GetExitCodeProcess(self.handle, &code) == WinFALSE) {
        return Result.Err(IoError.last_os_error());
      };
      return Result.Ok(Option.Some(ExitStatus { .exit_code = @as(i32, code), .term_signal = 0 }));
    } else {
      let status: c_int = 0;
      let r = waitpid(@as(c_pid_t, self.pid), &status, WNOHANG);
      if (r < 0) {
        return Result.Err(IoError.last_os_error());
      };
      if (r == 0) {
        let idle: Option[ExitStatus] = Option.None;
        return Result.Ok(idle);
      };
      return Result.Ok(Option.Some(decode_status(status)));
    }
  }

  /// Ask the child to terminate (SIGTERM on posix).
  pub fn kill(*self) Result[void, IoError] {
    @os[windows] {
      if (TerminateProcess(self.handle, 1) == WinFALSE) {
        return Result.Err(IoError.last_os_error());
      };
      return Result.Ok(@void());
    } else {
      if (kill(@as(c_pid_t, self.pid), SIGTERM) != 0) {
        return Result.Err(IoError.last_os_error());
      };
      return Result.Ok(@void());
    }
  }
}

implement Drop : Child {
  fn drop(self) {
    @os[windows] {
      if (self.win_in != nullptr) {
        let _ = CloseHandle(self.win_in);
      };
      if (self.win_out != nullptr) {
        let _ = CloseHandle(self.win_out);
      };
      if (self.win_err != nullptr) {
        let _ = CloseHandle(self.win_err);
      };
      if (self.handle != nullptr) {
        let _ = CloseHandle(self.handle);
      };
    } else {
      if (self.in_fd >= 0) {
        let _ = close(self.in_fd);
      };
      if (self.out_fd >= 0) {
        let _ = close(self.out_fd);
      };
      if (self.err_fd >= 0) {
        let _ = close(self.err_fd);
      };
    }
  }
}

/// One environment override: `remove` deletes the key, otherwise `value` wins.
struct CommandEnv {
  pub key: String,
  pub value: String,
  pub remove: bool,
}

/// A pending program invocation, in the shape of Rust `std::process::Command`.
pub struct Command {
  pub program: String,
  pub argv: List[String],
  pub envs: List[CommandEnv],
  pub env_cleared: bool,
  pub cwd: String,
  pub has_cwd: bool,
  pub stdin_mode: Stdio,
  pub stdout_mode: Stdio,
  pub stderr_mode: Stdio,

  /// Start building a command for `program` (PATH search on posix).
  pub fn new(program: []const char) Self {
    return Command {
      .program = String.from(program),
      .argv = List#[String].new(),
      .envs = List#[CommandEnv].new(),
      .env_cleared = false,
      .cwd = String.new(),
      .has_cwd = false,
      .stdin_mode = Stdio.Inherit,
      .stdout_mode = Stdio.Inherit,
      .stderr_mode = Stdio.Inherit,
    };
  }

  /// Append one argument.
  pub fn arg(*self, value: []const char) {
    self.argv.push(String.from(value));
  }

  /// Append every argument from the list.
  pub fn args(*self, values: *const List[String]) {
    let i: usize = 0;
    while (i < values.len()) {
      self.argv.push(values.get_ptr(i).unwrap().clone());
      i += 1;
    }
  }

  /// Set an environment variable for the child.
  pub fn env(*self, key: []const char, value: []const char) {
    self.envs.push(CommandEnv {
      .key = String.from(key),
      .value = String.from(value),
      .remove = false,
    });
  }

  /// Remove an environment variable for the child.
  pub fn env_remove(*self, key: []const char) {
    self.envs.push(CommandEnv {
      .key = String.from(key),
      .value = String.new(),
      .remove = true,
    });
  }

  /// Start the child with an empty environment.
  pub fn env_clear(*self) {
    self.env_cleared = true;
  }

  /// Run the child with this working directory.
  pub fn current_dir(*self, dir: []const char) {
    self.cwd = String.from(dir);
    self.has_cwd = true;
  }

  /// Configure the child stdin.
  pub fn stdin(*self, mode: Stdio) {
    self.stdin_mode = mode;
  }

  /// Configure the child stdout.
  pub fn stdout(*self, mode: Stdio) {
    self.stdout_mode = mode;
  }

  /// Configure the child stderr.
  pub fn stderr(*self, mode: Stdio) {
    self.stderr_mode = mode;
  }

  /// Spawn the child without waiting for it.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.NotFound
  /// * IoErrorKind.PermissionDenied
  /// * IoErrorKind.Uncategorized
  pub fn spawn(*const self) Result[Child, IoError] {
    @os[windows] {
      return spawn_windows(self);
    } else {
      return spawn_posix(self);
    }
  }

  /// Spawn, wait to completion, discard output. Piped streams are closed unread.
  pub fn status(*const self) Result[ExitStatus, IoError] {
    let spawned = self.spawn();
    if (spawned.is_err()) {
      return Result.Err(spawned.unwrap_err());
    };
    return spawned.unwrap().wait();
  }

  /// Spawn, capture piped stdout/stderr to completion.
  pub fn output(*self) Result[Output, IoError] {
    self.stdout_mode = Stdio.Piped;
    self.stderr_mode = Stdio.Piped;
    let spawned = self.spawn();
    if (spawned.is_err()) {
      return Result.Err(spawned.unwrap_err());
    };
    let child = spawned.unwrap();

    @os[windows] {
      let out_handle = child.win_out;
      let err_handle = child.win_err;
      let out_thread = Thread.spawn(fn() Result[String, IoError] {
        return drain_handle_to_string(out_handle);
      });
      let err_thread = Thread.spawn(fn() Result[String, IoError] {
        return drain_handle_to_string(err_handle);
      });
      let out_text = out_thread.join();
      let err_text = err_thread.join();
      if (out_text.is_err()) {
        return Result.Err(out_text.unwrap_err());
      };
      if (err_text.is_err()) {
        return Result.Err(err_text.unwrap_err());
      };
      let waited = child.wait();
      if (waited.is_err()) {
        return Result.Err(waited.unwrap_err());
      };
      return Result.Ok(Output {
        .status = waited.unwrap(),
        .stdout = out_text.unwrap(),
        .stderr = err_text.unwrap(),
      });
    } else {
      let out_fd = child.out_fd;
      let err_fd = child.err_fd;
      let out_thread = Thread.spawn(fn() Result[String, IoError] {
        return drain_fd_to_string(out_fd);
      });
      let err_thread = Thread.spawn(fn() Result[String, IoError] {
        return drain_fd_to_string(err_fd);
      });
      let out_text = out_thread.join();
      let err_text = err_thread.join();
      if (out_text.is_err()) {
        return Result.Err(out_text.unwrap_err());
      };
      if (err_text.is_err()) {
        return Result.Err(err_text.unwrap_err());
      };
      let waited = child.wait();
      if (waited.is_err()) {
        return Result.Err(waited.unwrap_err());
      };
      return Result.Ok(Output {
        .status = waited.unwrap(),
        .stdout = out_text.unwrap(),
        .stderr = err_text.unwrap(),
      });
    }
  }
}

/// Null terminated copy of text for C calls.
fn cstr(text: []const char) String {
  let s = String.from(text);
  s.push('\0');
  return s;
}

fn streq(a: []const char, b: []const char) bool {
  if (a.len != b.len) {
    return false;
  };
  let i: usize = 0;
  while (i < a.len) {
    if (a[i] != b[i]) {
      return false;
    };
    i += 1;
  };
  return true;
}

/// True when the command overrides the environment at all.
fn cmd_has_env_changes(cmd: *const Command) bool {
  return (*cmd).env_cleared || (*cmd).envs.len() != 0;
}

fn is_env_removed(cmd: *const Command, key: []const char) bool {
  let i: usize = 0;
  while (i < (*cmd).envs.len()) {
    let spec = (*cmd).envs.get_ptr(i).unwrap();
    if ((*spec).remove && streq((*spec).key.slice(..), key)) {
      return true;
    };
    i += 1;
  };
  return false;
}

fn is_env_overridden(cmd: *const Command, key: []const char) bool {
  let i: usize = 0;
  while (i < (*cmd).envs.len()) {
    let spec = (*cmd).envs.get_ptr(i).unwrap();
    if (!(*spec).remove && streq((*spec).key.slice(..), key)) {
      return true;
    };
    i += 1;
  };
  return false;
}

fn removed_after(cmd: *const Command, from: usize, key: []const char) bool {
  let i = from + 1;
  while (i < (*cmd).envs.len()) {
    let spec = (*cmd).envs.get_ptr(i).unwrap();
    if ((*spec).remove && streq((*spec).key.slice(..), key)) {
      return true;
    };
    i += 1;
  };
  return false;
}

fn overridden_after(cmd: *const Command, from: usize, key: []const char) bool {
  let i = from + 1;
  while (i < (*cmd).envs.len()) {
    let spec = (*cmd).envs.get_ptr(i).unwrap();
    if (!(*spec).remove && streq((*spec).key.slice(..), key)) {
      return true;
    };
    i += 1;
  };
  return false;
}

/// Inherited variables minus removals and overrides, then explicit entries.
fn merged_env(cmd: *const Command) List[String] {
  let out = List#[String].new();
  if (!(*cmd).env_cleared) {
    let current = Env.vars();
    let i: usize = 0;
    while (i < current.len()) {
      let entry = current.get_ptr(i).unwrap();
      let key = (*entry).key.slice(..);
      if (!is_env_removed(cmd, key) && !is_env_overridden(cmd, key)) {
        let pair = String.from(key);
        pair.push('=');
        pair.push_str((*entry).value.slice(..));
        out.push(pair);
      };
      i += 1;
    };
  };
  let j: usize = 0;
  while (j < (*cmd).envs.len()) {
    let spec = (*cmd).envs.get_ptr(j).unwrap();
    let key = (*spec).key.slice(..);
    if (!(*spec).remove && !removed_after(cmd, j, key) && !overridden_after(cmd, j, key)) {
      let pair = String.from(key);
      pair.push('=');
      pair.push_str((*spec).value.slice(..));
      out.push(pair);
    };
    j += 1;
  };
  return out;
}

@os[windows] {
  fn find_program(program: []const char) Option[String] {
    return Option.Some(String.from(program));
  }
}

@os[linux | android | darwin | freebsd] {
  /// Resolve `program` through PATH, absolute when it holds a slash.
  fn find_program(program: []const char) Option[String] {
    let has_slash = false;
    let si: usize = 0;
    while (si < program.len) {
      if (program[si] == '/') {
        has_slash = true;
        break;
      };
      si += 1;
    };
    if (has_slash) {
      return Option.Some(String.from(program));
    };
    let path = Env.var("PATH");
    if (path.is_none()) {
      return Option.None;
    };
    let owned_path = path.unwrap();
    let dirs = owned_path.split(':');
    let i: usize = 0;
    while (i < dirs.len()) {
      let candidate = String.from(dirs.get_ptr(i).unwrap().slice(..));
      candidate.push('/');
      candidate.push_str(program);
      let probe = cstr(candidate.slice(..));
      if (access(@as([*]const char, probe.slice(..).ptr), X_OK) == 0) {
        return Option.Some(candidate);
      };
      i += 1;
    };
    return Option.None;
  }
}

@os[linux | android | darwin | freebsd] {
  fn decode_status(status: c_int) ExitStatus {
    if (WIFEXITED(status)) {
      return ExitStatus { .exit_code = @as(i32, WEXITSTATUS(status)), .term_signal = 0 };
    };
    if (WIFSIGNALED(status)) {
      return ExitStatus { .exit_code = -1, .term_signal = @as(i32, WTERMSIG(status)) };
    };
    return ExitStatus { .exit_code = -1, .term_signal = 0 };
  }

  fn close_if_valid(fd: c_int) {
    if (fd >= 0) {
      let _ = close(fd);
    };
  }

  struct FdPair {
    pub read_end: c_int,
    pub write_end: c_int,
  }

  fn make_pipe() Result[FdPair, IoError] {
    let fds: [2]c_int = @uninit();
    if (pipe(&fds[0]) != 0) {
      return Result.Err(IoError.last_os_error());
    };
    return Result.Ok(FdPair { .read_end = fds[0], .write_end = fds[1] });
  }

  fn open_null(write: bool) Result[c_int, IoError] {
    let path = cstr("/dev/null");
    let mode = if (write) { O_WRONLY } else { O_RDONLY };
    let fd = open(@as([*]const char, path.slice(..).ptr), mode, 0);
    if (fd < 0) {
      return Result.Err(IoError.last_os_error());
    };
    return Result.Ok(fd);
  }

  fn read_fd_to_string(fd: c_int, out: *String) Result[usize, IoError] {
    let total: usize = 0;
    while (true) {
      let chunk: [256]char = @uninit();
      let got = read(fd, @as(*void, &chunk[0]), 256);
      if (got < 0) {
        let err_slot = __errno_location();
        if (*err_slot == EINTR) {
          continue;
        };
        return Result.Err(IoError.last_os_error());
      };
      if (got == 0) {
        break;
      };
      (*out).push_str(chunk[0..@as(usize, got)]);
      total += @as(usize, got);
    };
    return Result.Ok(total);
  }

  fn write_fd_all(fd: c_int, buf: []const char) Result[void, IoError] {
    let off: usize = 0;
    while (off < buf.len) {
      let rest = buf[off..buf.len];
      let n = write(fd, @as([*]const void, rest.ptr), @as(c_size_t, rest.len));
      if (n < 0) {
        let err_slot = __errno_location();
        if (*err_slot == EINTR) {
          continue;
        };
        return Result.Err(IoError.last_os_error());
      };
      off += @as(usize, n);
    };
    return Result.Ok(@void());
  }

  fn drain_fd_to_string(fd: c_int) Result[String, IoError] {
    let out = String.new();
    let r = read_fd_to_string(fd, &out);
    if (r.is_err()) {
      return Result.Err(r.unwrap_err());
    };
    return Result.Ok(out);
  }

  fn spawn_posix(cmd: *const Command) Result[Child, IoError] {
    let prog = find_program((*cmd).program.slice(..));
    if (prog.is_none()) {
      return Result.Err(IoError.new(IoErrorKind.NotFound, "program not found in PATH"));
    };
    let prog_path = cstr(prog.unwrap().slice(..));
    let prog_ptr = @as([*]const char, prog_path.slice(..).ptr);

    let argv_strs = List#[String].new();
    argv_strs.push(prog_path.clone());
    let ai: usize = 0;
    while (ai < (*cmd).argv.len()) {
      argv_strs.push(cstr((*cmd).argv.get_ptr(ai).unwrap().slice(..)));
      ai += 1;
    };
    let argv = List#[[*]const char].new();
    let aj: usize = 0;
    while (aj < argv_strs.len()) {
      argv.push(@as([*]const char, argv_strs.get_ptr(aj).unwrap().slice(..).ptr));
      aj += 1;
    };
    argv.push(@as([*]const char, nullptr));
    let argv_ptr = argv.get_ptr(0).unwrap();

    let inherit_env = !cmd_has_env_changes(cmd);
    let env_strs = List#[String].new();
    let envp = List#[[*]const char].new();
    if (!inherit_env) {
      let merged = merged_env(cmd);
      let mi: usize = 0;
      while (mi < merged.len()) {
        env_strs.push(cstr(merged.get_ptr(mi).unwrap().slice(..)));
        mi += 1;
      };
      let ei: usize = 0;
      while (ei < env_strs.len()) {
        envp.push(@as([*]const char, env_strs.get_ptr(ei).unwrap().slice(..).ptr));
        ei += 1;
      };
      envp.push(@as([*]const char, nullptr));
    };

    let stdin_read: c_int = -1;
    let stdin_write: c_int = -1;
    let stdout_read: c_int = -1;
    let stdout_write: c_int = -1;
    let stderr_read: c_int = -1;
    let stderr_write: c_int = -1;

    if ((*cmd).stdin_mode == Stdio.Piped) {
      let made = make_pipe();
      if (made.is_err()) {
        return Result.Err(made.unwrap_err());
      };
      let ends = made.unwrap();
      stdin_read = ends.read_end;
      stdin_write = ends.write_end;
    } else if ((*cmd).stdin_mode == Stdio.Null) {
      let opened = open_null(false);
      if (opened.is_err()) {
        return Result.Err(opened.unwrap_err());
      };
      stdin_read = opened.unwrap();
    };

    if ((*cmd).stdout_mode == Stdio.Piped) {
      let made = make_pipe();
      if (made.is_err()) {
        close_if_valid(stdin_read);
        close_if_valid(stdin_write);
        return Result.Err(made.unwrap_err());
      };
      let ends = made.unwrap();
      stdout_read = ends.read_end;
      stdout_write = ends.write_end;
    } else if ((*cmd).stdout_mode == Stdio.Null) {
      let opened = open_null(true);
      if (opened.is_err()) {
        close_if_valid(stdin_read);
        close_if_valid(stdin_write);
        return Result.Err(opened.unwrap_err());
      };
      stdout_write = opened.unwrap();
    };

    if ((*cmd).stderr_mode == Stdio.Piped) {
      let made = make_pipe();
      if (made.is_err()) {
        close_if_valid(stdin_read);
        close_if_valid(stdin_write);
        close_if_valid(stdout_read);
        close_if_valid(stdout_write);
        return Result.Err(made.unwrap_err());
      };
      let ends = made.unwrap();
      stderr_read = ends.read_end;
      stderr_write = ends.write_end;
    } else if ((*cmd).stderr_mode == Stdio.Null) {
      let opened = open_null(true);
      if (opened.is_err()) {
        close_if_valid(stdin_read);
        close_if_valid(stdin_write);
        close_if_valid(stdout_read);
        close_if_valid(stdout_write);
        return Result.Err(opened.unwrap_err());
      };
      stderr_write = opened.unwrap();
    };

    let err_pair = make_pipe();
    if (err_pair.is_err()) {
      close_if_valid(stdin_read);
      close_if_valid(stdin_write);
      close_if_valid(stdout_read);
      close_if_valid(stdout_write);
      close_if_valid(stderr_read);
      close_if_valid(stderr_write);
      return Result.Err(err_pair.unwrap_err());
    };
    let err_ends = err_pair.unwrap();
    let err_read = err_ends.read_end;
    let err_write = err_ends.write_end;
    let _ = fcntl(err_write, F_SETFD, FD_CLOEXEC);

    let pid = fork();
    if (pid < 0) {
      let err = IoError.last_os_error();
      close_if_valid(stdin_read);
      close_if_valid(stdin_write);
      close_if_valid(stdout_read);
      close_if_valid(stdout_write);
      close_if_valid(stderr_read);
      close_if_valid(stderr_write);
      close_if_valid(err_read);
      close_if_valid(err_write);
      return Result.Err(err);
    };

    if (pid == 0) {
      let _ = close(err_read);
      if ((*cmd).has_cwd) {
        let dir = cstr((*cmd).cwd.slice(..));
        if (chdir(@as([*]const char, dir.slice(..).ptr)) != 0) {
          let slot = __errno_location();
          let code: c_int = *slot;
          let _ = write(err_write, @as([*]const void, &code), 4);
          _exit(127);
        };
      };
      if (stdin_read >= 0) {
        let _ = dup2(stdin_read, STDIN_FILENO);
      };
      if (stdout_write >= 0) {
        let _ = dup2(stdout_write, STDOUT_FILENO);
      };
      if (stderr_write >= 0) {
        let _ = dup2(stderr_write, STDERR_FILENO);
      };
      close_if_valid(stdin_read);
      close_if_valid(stdin_write);
      close_if_valid(stdout_read);
      close_if_valid(stdout_write);
      close_if_valid(stderr_read);
      close_if_valid(stderr_write);
      if (inherit_env) {
        let _ = execvp(prog_ptr, argv_ptr);
      } else {
        let envp_ptr = envp.get_ptr(0).unwrap();
        let _ = execve(prog_ptr, argv_ptr, envp_ptr);
      };
      let slot = __errno_location();
      let code: c_int = *slot;
      let _ = write(err_write, @as([*]const void, &code), 4);
      _exit(127);
    };

    let _ = close(err_write);
    close_if_valid(stdin_read);
    close_if_valid(stdout_write);
    close_if_valid(stderr_write);
    if (stdin_write >= 0) {
      let _ = fcntl(stdin_write, F_SETFD, FD_CLOEXEC);
    };
    if (stdout_read >= 0) {
      let _ = fcntl(stdout_read, F_SETFD, FD_CLOEXEC);
    };
    if (stderr_read >= 0) {
      let _ = fcntl(stderr_read, F_SETFD, FD_CLOEXEC);
    };

    let err_code: c_int = 0;
    let got = read(err_read, @as(*void, &err_code), 4);
    let _ = close(err_read);
    if (got == 4) {
      let status: c_int = 0;
      let _ = waitpid(pid, &status, 0);
      close_if_valid(stdin_write);
      close_if_valid(stdout_read);
      close_if_valid(stderr_read);
      return Result.Err(IoError.from_errno(err_code));
    };

    return Result.Ok(Child {
      .pid = @as(i32, pid),
      .handle = nullptr,
      .in_fd = stdin_write,
      .out_fd = stdout_read,
      .err_fd = stderr_read,
      .win_in = nullptr,
      .win_out = nullptr,
      .win_err = nullptr,
    });
  }
}

@os[windows] {
  fn utf16_push(out: *List[u16], text: []const char) {
    let i: usize = 0;
    while (i < text.len) {
      let b = @as(u32, text[i]);
      if (b < 128) {
        (*out).push(@as(u16, b));
        i += 1;
      } else if (b >= 194 && b < 224) {
        if (i + 1 >= text.len) {
          (*out).push(@as(u16, 65533));
          break;
        };
        let c = @as(u32, text[i + 1]);
        if (c < 128 || c >= 192) {
          (*out).push(@as(u16, 65533));
          i += 1;
        } else {
          (*out).push(@as(u16, (b - 192) * 64 + (c - 128)));
          i += 2;
        };
      } else if (b >= 224 && b < 240) {
        if (i + 2 >= text.len) {
          (*out).push(@as(u16, 65533));
          break;
        };
        let c1 = @as(u32, text[i + 1]);
        let c2 = @as(u32, text[i + 2]);
        let cp = (b - 224) * 4096 + (c1 - 128) * 64 + (c2 - 128);
        if (c1 < 128 || c1 >= 192 || c2 < 128 || c2 >= 192 || cp < 2048 || (cp >= 55296 && cp <= 57343)) {
          (*out).push(@as(u16, 65533));
          i += 1;
        } else {
          (*out).push(@as(u16, cp));
          i += 3;
        };
      } else if (b >= 240 && b < 245) {
        if (i + 3 >= text.len) {
          (*out).push(@as(u16, 65533));
          break;
        };
        let c1 = @as(u32, text[i + 1]);
        let c2 = @as(u32, text[i + 2]);
        let c3 = @as(u32, text[i + 3]);
        let cp = (b - 240) * 262144 + (c1 - 128) * 4096 + (c2 - 128) * 64 + (c3 - 128);
        if (c1 < 128 || c1 >= 192 || c2 < 128 || c2 >= 192 || c3 < 128 || c3 >= 192 || cp < 65536 || cp > 1114111) {
          (*out).push(@as(u16, 65533));
          i += 1;
        } else {
          let v = cp - 65536;
          (*out).push(@as(u16, 55296 + (v >> 10)));
          (*out).push(@as(u16, 56320 + (v & 1023)));
          i += 4;
        };
      } else {
        (*out).push(@as(u16, 65533));
        i += 1;
      };
    };
  }

  fn wide_from(text: []const char) List[u16] {
    let out = List#[u16].new();
    utf16_push(&out, text);
    out.push(@as(u16, 0));
    return out;
  }

  fn push_backslashes(line: *List[u16], count: usize) {
    let i: usize = 0;
    while (i < count) {
      (*line).push(@as(u16, 92));
      i += 1;
    };
  }

  fn append_quoted(line: *List[u16], arg: []const char) {
    let need = arg.len == 0;
    let s: usize = 0;
    while (s < arg.len) {
      let c = arg[s];
      if (c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '"') {
        need = true;
        break;
      };
      s += 1;
    };
    if (!need) {
      utf16_push(line, arg);
      return;
    };
    (*line).push(@as(u16, '"'));
    let slashes: usize = 0;
    let j: usize = 0;
    while (j < arg.len) {
      let c = arg[j];
      if (@as(u32, c) == 92) {
        slashes += 1;
      } else {
        if (c == '"') {
          push_backslashes(line, slashes * 2 + 1);
        } else {
          push_backslashes(line, slashes);
        };
        slashes = 0;
        (*line).push(@as(u16, @as(u32, c)));
      };
      j += 1;
    };
    push_backslashes(line, slashes * 2);
    (*line).push(@as(u16, '"'));
  }

  fn close_win_handle(handle: WinHANDLE) {
    if (handle != nullptr) {
      let _ = CloseHandle(handle);
    };
  }

  struct WinPipe {
    pub read_end: WinHANDLE,
    pub write_end: WinHANDLE,
  }

  fn make_win_pipe() Result[WinPipe, IoError] {
    let sa = c_SECURITY_ATTRIBUTES {
      .n_length = @as(WinDWORD, @sizeof(c_SECURITY_ATTRIBUTES)),
      .lp_security_descriptor = nullptr,
      .b_inherit_handle = WinTRUE,
    };
    let h_read: WinHANDLE = nullptr;
    let h_write: WinHANDLE = nullptr;
    if (CreatePipe(&h_read, &h_write, @as(*void, &sa), 0) == WinFALSE) {
      return Result.Err(IoError.last_os_error());
    };
    return Result.Ok(WinPipe { .read_end = h_read, .write_end = h_write });
  }

  fn open_win_null(write: bool) Result[WinHANDLE, IoError] {
    let name = wide_from("NUL");
    let access = if (write) { GENERIC_WRITE } else { GENERIC_READ };
    let h = CreateFileW(
      @as([*]const c_wchar_t, name.get_ptr(0).unwrap()),
      access,
      FILE_SHARE_READ,
      nullptr,
      OPEN_EXISTING,
      FILE_ATTRIBUTE_NORMAL,
      nullptr,
    );
    if (h == INVALID_HANDLE_VALUE || h == nullptr) {
      return Result.Err(IoError.last_os_error());
    };
    return Result.Ok(h);
  }

  fn read_handle_to_string(handle: *void, out: *String) Result[usize, IoError] {
    let total: usize = 0;
    while (true) {
      let chunk: [256]char = @uninit();
      let got: WinDWORD = 0;
      let ok = ReadFile(@as(WinHANDLE, handle), @as(*void, &chunk[0]), 256, &got, nullptr);
      if (ok == WinFALSE) {
        if (GetLastError() == ERROR_BROKEN_PIPE) {
          break;
        };
        return Result.Err(IoError.last_os_error());
      };
      if (got == 0) {
        break;
      };
      (*out).push_str(chunk[0..@as(usize, got)]);
      total += @as(usize, got);
    };
    return Result.Ok(total);
  }

  fn write_handle_all(handle: *void, buf: []const char) Result[void, IoError] {
    let off: usize = 0;
    while (off < buf.len) {
      let rest = buf[off..buf.len];
      let written: WinDWORD = 0;
      let ok = WriteFile(
        @as(WinHANDLE, handle),
        @as(*const void, rest.ptr),
        @as(WinDWORD, rest.len),
        &written,
        nullptr,
      );
      if (ok == WinFALSE) {
        return Result.Err(IoError.last_os_error());
      };
      off += @as(usize, written);
    };
    return Result.Ok(@void());
  }

  fn drain_handle_to_string(handle: *void) Result[String, IoError] {
    let out = String.new();
    let r = read_handle_to_string(handle, &out);
    if (r.is_err()) {
      return Result.Err(r.unwrap_err());
    };
    return Result.Ok(out);
  }

  fn spawn_windows(cmd: *const Command) Result[Child, IoError] {
    let line = List#[u16].new();
    append_quoted(&line, (*cmd).program.slice(..));
    let ai: usize = 0;
    while (ai < (*cmd).argv.len()) {
      line.push(@as(u16, ' '));
      append_quoted(&line, (*cmd).argv.get_ptr(ai).unwrap().slice(..));
      ai += 1;
    };
    line.push(@as(u16, 0));
    let cmdline = @as([*]c_wchar_t, line.get_ptr(0).unwrap());

    let env_block = List#[u16].new();
    let use_custom_env = cmd_has_env_changes(cmd);
    if (use_custom_env) {
      let pairs = merged_env(cmd);
      let pi: usize = 0;
      while (pi < pairs.len()) {
        utf16_push(&env_block, pairs.get_ptr(pi).unwrap().slice(..));
        env_block.push(@as(u16, 0));
        pi += 1;
      };
      env_block.push(@as(u16, 0));
    };
    let env_ptr: *void = nullptr;
    if (use_custom_env) {
      env_ptr = @as(*void, env_block.get_ptr(0).unwrap());
    };

    let cwd_block = List#[u16].new();
    if ((*cmd).has_cwd) {
      utf16_push(&cwd_block, (*cmd).cwd.slice(..));
      cwd_block.push(@as(u16, 0));
    };
    let cwd_ptr = @as([*]c_wchar_t, nullptr);
    if ((*cmd).has_cwd) {
      cwd_ptr = @as([*]c_wchar_t, cwd_block.get_ptr(0).unwrap());
    };

    let stdin_h: WinHANDLE = nullptr;
    let parent_stdin: WinHANDLE = nullptr;
    let stdout_h: WinHANDLE = nullptr;
    let parent_stdout: WinHANDLE = nullptr;
    let stderr_h: WinHANDLE = nullptr;
    let parent_stderr: WinHANDLE = nullptr;

    if ((*cmd).stdin_mode == Stdio.Piped) {
      let made = make_win_pipe();
      if (made.is_err()) {
        return Result.Err(made.unwrap_err());
      };
      let ends = made.unwrap();
      stdin_h = ends.read_end;
      parent_stdin = ends.write_end;
      let _ = SetHandleInformation(parent_stdin, HANDLE_FLAG_INHERIT, 0);
    } else if ((*cmd).stdin_mode == Stdio.Null) {
      let opened = open_win_null(false);
      if (opened.is_err()) {
        return Result.Err(opened.unwrap_err());
      };
      stdin_h = opened.unwrap();
    } else {
      stdin_h = GetStdHandle(STD_INPUT_HANDLE);
    };

    if ((*cmd).stdout_mode == Stdio.Piped) {
      let made = make_win_pipe();
      if (made.is_err()) {
        close_win_handle(stdin_h);
        return Result.Err(made.unwrap_err());
      };
      let ends = made.unwrap();
      stdout_h = ends.write_end;
      parent_stdout = ends.read_end;
      let _ = SetHandleInformation(parent_stdout, HANDLE_FLAG_INHERIT, 0);
    } else if ((*cmd).stdout_mode == Stdio.Null) {
      let opened = open_win_null(true);
      if (opened.is_err()) {
        close_win_handle(stdin_h);
        return Result.Err(opened.unwrap_err());
      };
      stdout_h = opened.unwrap();
    } else {
      stdout_h = GetStdHandle(STD_OUTPUT_HANDLE);
    };

    if ((*cmd).stderr_mode == Stdio.Piped) {
      let made = make_win_pipe();
      if (made.is_err()) {
        close_win_handle(stdin_h);
        close_win_handle(stdout_h);
        return Result.Err(made.unwrap_err());
      };
      let ends = made.unwrap();
      stderr_h = ends.write_end;
      parent_stderr = ends.read_end;
      let _ = SetHandleInformation(parent_stderr, HANDLE_FLAG_INHERIT, 0);
    } else if ((*cmd).stderr_mode == Stdio.Null) {
      let opened = open_win_null(true);
      if (opened.is_err()) {
        close_win_handle(stdin_h);
        close_win_handle(stdout_h);
        return Result.Err(opened.unwrap_err());
      };
      stderr_h = opened.unwrap();
    } else {
      stderr_h = GetStdHandle(STD_ERROR_HANDLE);
    };

    let si: c_STARTUPINFOW = @uninit();
    si.cb = @as(WinDWORD, @sizeof(c_STARTUPINFOW));
    si.lp_reserved = nullptr;
    si.lp_desktop = nullptr;
    si.lp_title = nullptr;
    si.dw_x = 0;
    si.dw_y = 0;
    si.dw_x_size = 0;
    si.dw_y_size = 0;
    si.dw_x_count_chars = 0;
    si.dw_y_count_chars = 0;
    si.dw_fill_attribute = 0;
    si.dw_flags = STARTF_USESTDHANDLES;
    si.w_show_window = 0;
    si.cb_reserved2 = 0;
    si.lp_reserved2 = nullptr;
    si.h_std_input = stdin_h;
    si.h_std_output = stdout_h;
    si.h_std_error = stderr_h;

    let pi: c_PROCESS_INFORMATION = @uninit();
    let creation_flags: WinDWORD = 0;
    if (use_custom_env) {
      creation_flags = CREATE_UNICODE_ENVIRONMENT;
    };
    let ok = CreateProcessW(
      @as([*]const c_wchar_t, nullptr),
      cmdline,
      nullptr,
      nullptr,
      WinTRUE,
      creation_flags,
      env_ptr,
      cwd_ptr,
      &si,
      &pi,
    );
    if (ok == WinFALSE) {
      let err = IoError.last_os_error();
      if ((*cmd).stdin_mode != Stdio.Inherit) {
        close_win_handle(stdin_h);
      };
      close_win_handle(parent_stdin);
      if ((*cmd).stdout_mode != Stdio.Inherit) {
        close_win_handle(stdout_h);
      };
      close_win_handle(parent_stdout);
      if ((*cmd).stderr_mode != Stdio.Inherit) {
        close_win_handle(stderr_h);
      };
      close_win_handle(parent_stderr);
      return Result.Err(err);
    };
    let _ = CloseHandle(pi.h_thread);
    if ((*cmd).stdin_mode != Stdio.Inherit) {
      close_win_handle(stdin_h);
    };
    if ((*cmd).stdout_mode != Stdio.Inherit) {
      close_win_handle(stdout_h);
    };
    if ((*cmd).stderr_mode != Stdio.Inherit) {
      close_win_handle(stderr_h);
    };

    return Result.Ok(Child {
      .pid = @as(i32, pi.dw_process_id),
      .handle = pi.h_process,
      .in_fd = -1,
      .out_fd = -1,
      .err_fd = -1,
      .win_in = parent_stdin,
      .win_out = parent_stdout,
      .win_err = parent_stderr,
    });
  }
}
