use std.string;
use std.list;
use std.io;
use std.net;

/// HTTP request method.
pub enum Method {
  Get,
  Post,
  Put,
  Delete,
  Patch,
  Head,
  Options,
  Unknown,
}

/// One `Name: value` header line.
pub struct Header {
  pub name: String,
  pub value: String,
}

/// Header map. Lookup is case insensitive and clones the value.
pub struct Headers {
  inner: List[Header],

  pub fn push(*self, name: String, value: String) {
    self.inner.push(Header { .name = name, .value = value });
  }

  pub fn get(*const self, name: []const char) Option[String] {
    let i: usize = 0;

    while (i < self.inner.len()) {
      switch (self.inner.get_ptr(i)) {
        .Some(h) => if (header_name_eq(&(*h).name, name)) {
          return Option.Some((*h).value.clone());
        },
        .None => {},
      };

      i += 1;
    };

    return Option.None;
  }
}

fn lower_byte(c: char) char {
  let v = @as(u32, c);

  if (v >= @as(u32, 'A') && v <= @as(u32, 'Z')) {
    return @as(char, v + 32);
  };

  return c;
}

fn header_name_eq(a: *const String, b: []const char) bool {
  if ((*a).len() != b.len) {
    return false;
  };

  let i: usize = 0;

  while (i < b.len) {
    if (lower_byte((*a).get(i).unwrap()) != lower_byte(b.ptr[i])) {
      return false;
    };

    i += 1;
  };

  return true;
}

/// Parsed HTTP request.
pub struct Request {
  pub method: Method,
  pub path: String,
  pub headers: Headers,
  pub body: String,

  pub fn header(*const self, name: []const char) Option[String] {
    self.headers.get(name)
  }
}

/// HTTP response builder.
pub struct Response {
  status: u16,
  body: String,

  pub fn new(status: u16, body: []const char) Self {
    Self {
      .status = status,
      .body = String.from(body),
    }
  }

  pub fn empty(status: u16) Self {
    Self {
      .status = status,
      .body = String.new(),
    }
  }

  pub fn status_code(*const self) u16 {
    self.status
  }

  pub fn set_status_code(*self, code: u16) {
    self.status = code;
  }

  pub fn ok(body: []const char) Self {
    Self {
      .status = 200,
      .body = String.from(body),
    }
  }

  pub fn not_found() Self {
    Self {
      .status = 404,
      .body = String.from("Not Found\n"),
    }
  }

  pub fn continue_() Self {
    Self {
      .status = 100,
      .body = String.new(),
    }
  }

  pub fn switching_protocols() Self {
    Self {
      .status = 101,
      .body = String.new(),
    }
  }

  pub fn processing() Self {
    Self {
      .status = 102,
      .body = String.new(),
    }
  }

  pub fn early_hints() Self {
    Self {
      .status = 103,
      .body = String.new(),
    }
  }

  pub fn created(body: []const char) Self {
    Self {
      .status = 201,
      .body = String.from(body),
    }
  }

  pub fn accepted(body: []const char) Self {
    Self {
      .status = 202,
      .body = String.from(body),
    }
  }

  pub fn non_authoritative_information(body: []const char) Self {
    Self {
      .status = 203,
      .body = String.from(body),
    }
  }

  pub fn no_content() Self {
    Self {
      .status = 204,
      .body = String.new(),
    }
  }

  pub fn reset_content() Self {
    Self {
      .status = 205,
      .body = String.new(),
    }
  }

  pub fn partial_content(body: []const char) Self {
    Self {
      .status = 206,
      .body = String.from(body),
    }
  }

  pub fn multi_status(body: []const char) Self {
    Self {
      .status = 207,
      .body = String.from(body),
    }
  }

  pub fn already_reported(body: []const char) Self {
    Self {
      .status = 208,
      .body = String.from(body),
    }
  }

  pub fn im_used(body: []const char) Self {
    Self {
      .status = 226,
      .body = String.from(body),
    }
  }

  pub fn multiple_choices(body: []const char) Self {
    Self {
      .status = 300,
      .body = String.from(body),
    }
  }

  pub fn moved_permanently(body: []const char) Self {
    Self {
      .status = 301,
      .body = String.from(body),
    }
  }

  pub fn found(body: []const char) Self {
    Self {
      .status = 302,
      .body = String.from(body),
    }
  }

  pub fn see_other(body: []const char) Self {
    Self {
      .status = 303,
      .body = String.from(body),
    }
  }

  pub fn not_modified() Self {
    Self {
      .status = 304,
      .body = String.new(),
    }
  }

  pub fn use_proxy(body: []const char) Self {
    Self {
      .status = 305,
      .body = String.from(body),
    }
  }

  pub fn temporary_redirect(body: []const char) Self {
    Self {
      .status = 307,
      .body = String.from(body),
    }
  }

  pub fn permanent_redirect(body: []const char) Self {
    Self {
      .status = 308,
      .body = String.from(body),
    }
  }

  pub fn bad_request(body: []const char) Self {
    Self {
      .status = 400,
      .body = String.from(body),
    }
  }

  pub fn unauthorized(body: []const char) Self {
    Self {
      .status = 401,
      .body = String.from(body),
    }
  }

  pub fn payment_required(body: []const char) Self {
    Self {
      .status = 402,
      .body = String.from(body),
    }
  }

  pub fn forbidden(body: []const char) Self {
    Self {
      .status = 403,
      .body = String.from(body),
    }
  }

  pub fn method_not_allowed(body: []const char) Self {
    Self {
      .status = 405,
      .body = String.from(body),
    }
  }

  pub fn not_acceptable(body: []const char) Self {
    Self {
      .status = 406,
      .body = String.from(body),
    }
  }

  pub fn proxy_authentication_required(body: []const char) Self {
    Self {
      .status = 407,
      .body = String.from(body),
    }
  }

  pub fn request_timeout(body: []const char) Self {
    Self {
      .status = 408,
      .body = String.from(body),
    }
  }

  pub fn conflict(body: []const char) Self {
    Self {
      .status = 409,
      .body = String.from(body),
    }
  }

  pub fn gone(body: []const char) Self {
    Self {
      .status = 410,
      .body = String.from(body),
    }
  }

  pub fn length_required(body: []const char) Self {
    Self {
      .status = 411,
      .body = String.from(body),
    }
  }

  pub fn precondition_failed(body: []const char) Self {
    Self {
      .status = 412,
      .body = String.from(body),
    }
  }

  pub fn payload_too_large(body: []const char) Self {
    Self {
      .status = 413,
      .body = String.from(body),
    }
  }

  pub fn uri_too_long(body: []const char) Self {
    Self {
      .status = 414,
      .body = String.from(body),
    }
  }

  pub fn unsupported_media_type(body: []const char) Self {
    Self {
      .status = 415,
      .body = String.from(body),
    }
  }

  pub fn range_not_satisfiable(body: []const char) Self {
    Self {
      .status = 416,
      .body = String.from(body),
    }
  }

  pub fn expectation_failed(body: []const char) Self {
    Self {
      .status = 417,
      .body = String.from(body),
    }
  }

  pub fn im_a_teapot(body: []const char) Self {
    Self {
      .status = 418,
      .body = String.from(body),
    }
  }

  pub fn misdirected_request(body: []const char) Self {
    Self {
      .status = 421,
      .body = String.from(body),
    }
  }

  pub fn unprocessable_content(body: []const char) Self {
    Self {
      .status = 422,
      .body = String.from(body),
    }
  }

  pub fn locked(body: []const char) Self {
    Self {
      .status = 423,
      .body = String.from(body),
    }
  }

  pub fn failed_dependency(body: []const char) Self {
    Self {
      .status = 424,
      .body = String.from(body),
    }
  }

  pub fn too_early(body: []const char) Self {
    Self {
      .status = 425,
      .body = String.from(body),
    }
  }

  pub fn upgrade_required(body: []const char) Self {
    Self {
      .status = 426,
      .body = String.from(body),
    }
  }

  pub fn precondition_required(body: []const char) Self {
    Self {
      .status = 428,
      .body = String.from(body),
    }
  }

  pub fn too_many_requests(body: []const char) Self {
    Self {
      .status = 429,
      .body = String.from(body),
    }
  }

  pub fn request_header_fields_too_large(body: []const char) Self {
    Self {
      .status = 431,
      .body = String.from(body),
    }
  }

  pub fn unavailable_for_legal_reasons(body: []const char) Self {
    Self {
      .status = 451,
      .body = String.from(body),
    }
  }

  pub fn internal_server_error(body: []const char) Self {
    Self {
      .status = 500,
      .body = String.from(body),
    }
  }

  pub fn not_implemented(body: []const char) Self {
    Self {
      .status = 501,
      .body = String.from(body),
    }
  }

  pub fn bad_gateway(body: []const char) Self {
    Self {
      .status = 502,
      .body = String.from(body),
    }
  }

  pub fn service_unavailable(body: []const char) Self {
    Self {
      .status = 503,
      .body = String.from(body),
    }
  }

  pub fn gateway_timeout(body: []const char) Self {
    Self {
      .status = 504,
      .body = String.from(body),
    }
  }

  pub fn http_version_not_supported(body: []const char) Self {
    Self {
      .status = 505,
      .body = String.from(body),
    }
  }

  pub fn variant_also_negotiates(body: []const char) Self {
    Self {
      .status = 506,
      .body = String.from(body),
    }
  }

  pub fn insufficient_storage(body: []const char) Self {
    Self {
      .status = 507,
      .body = String.from(body),
    }
  }

  pub fn loop_detected(body: []const char) Self {
    Self {
      .status = 508,
      .body = String.from(body),
    }
  }

  pub fn not_extended(body: []const char) Self {
    Self {
      .status = 510,
      .body = String.from(body),
    }
  }

  pub fn network_authentication_required(body: []const char) Self {
    Self {
      .status = 511,
      .body = String.from(body),
    }
  }

  pub fn send(*self, stream: *TcpStream) Result[void, IoError] {
    let head = @format(
      "HTTP/1.1 {} {}\r\nContent-Type: text/plain\r\nContent-Length: {}\r\nConnection: close\r\n\r\n",
      self.status,
      status_text(self.status),
      self.body.len(),
    );

    switch ((*stream).write_all(head.slice(..))) {
      .Ok(_) => {},
      .Err(e) => {
        return Result.Err(e);
      },
    };

    switch ((*stream).write_all(self.body.slice(..))) {
      .Ok(_) => {},
      .Err(e) => {
        return Result.Err(e);
      },
    };

    return Result.Ok(@void());
  }
}

fn status_text(status: u16) []const char {
  switch (status) {
    100 => "Continue",
    101 => "Switching Protocols",
    102 => "Processing",
    103 => "Early Hints",
    200 => "OK",
    201 => "Created",
    202 => "Accepted",
    203 => "Non-Authoritative Information",
    204 => "No Content",
    205 => "Reset Content",
    206 => "Partial Content",
    207 => "Multi-Status",
    208 => "Already Reported",
    226 => "IM Used",
    300 => "Multiple Choices",
    301 => "Moved Permanently",
    302 => "Found",
    303 => "See Other",
    304 => "Not Modified",
    305 => "Use Proxy",
    307 => "Temporary Redirect",
    308 => "Permanent Redirect",
    400 => "Bad Request",
    401 => "Unauthorized",
    402 => "Payment Required",
    403 => "Forbidden",
    404 => "Not Found",
    405 => "Method Not Allowed",
    406 => "Not Acceptable",
    407 => "Proxy Authentication Required",
    408 => "Request Timeout",
    409 => "Conflict",
    410 => "Gone",
    411 => "Length Required",
    412 => "Precondition Failed",
    413 => "Payload Too Large",
    414 => "URI Too Long",
    415 => "Unsupported Media Type",
    416 => "Range Not Satisfiable",
    417 => "Expectation Failed",
    418 => "I Am A Teapot",
    421 => "Misdirected Request",
    422 => "Unprocessable Content",
    423 => "Locked",
    424 => "Failed Dependency",
    425 => "Too Early",
    426 => "Upgrade Required",
    428 => "Precondition Required",
    429 => "Too Many Requests",
    431 => "Request Header Fields Too Large",
    451 => "Unavailable For Legal Reasons",
    500 => "Internal Server Error",
    501 => "Not Implemented",
    502 => "Bad Gateway",
    503 => "Service Unavailable",
    504 => "Gateway Timeout",
    505 => "HTTP Version Not Supported",
    506 => "Variant Also Negotiates",
    507 => "Insufficient Storage",
    508 => "Loop Detected",
    510 => "Not Extended",
    511 => "Network Authentication Required",
    _ => "Unknown",
  }
}

/// Blocking single threaded HTTP server.
pub struct HttpServer {
  listener: TcpListener,

  pub fn bind(addr: *const SocketAddr) Result[Self, IoError] {
    switch (TcpListener.bind(addr)) {
      .Ok(listener) => Result.Ok(Self { .listener = listener }),
      .Err(e) => {
        return Result.Err(e);
      },
    };
  }

  pub fn accept(*const self) Result[TcpStream, IoError] {
    self.listener.accept()
  }

  /// Read one request head and an optional body.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.ConnectionReset
  /// * IoErrorKind.Interrupted
  /// * IoErrorKind.InvalidData
  /// * IoErrorKind.UnexpectedEof
  /// * IoErrorKind.Uncategorized
  pub fn read_request(stream: *TcpStream) Result[Request, IoError] {
    let head = String.new();

    while (true) {
      switch ((*stream).read(&head)) {
        .Ok(got) => if (got == 0) {
          break;
        } else {},
        .Err(e) => {
          return Result.Err(e);
        },
      };

      if (head.contains_str("\r\n\r\n")) {
        break;
      };

      if (head.len() > 8192) {
        return Result.Err(IoError.new(IoErrorKind.InvalidData, "header too large"));
      };
    };

    return parse_request(&head, stream);
  }
}

fn parse_request(head: *String, stream: *TcpStream) Result[Request, IoError] {
  let lines = (*head).split('\n');

  if (lines.is_empty()) {
    return Result.Err(IoError.new(IoErrorKind.InvalidData, "empty request"));
  };

  let request_line = String.from((*lines.get_ptr(0).unwrap()).trim_end());
  let parts = request_line.split(' ');

  switch (parts.get_ptr(0)) {
    .Some(_) => {},
    .None => {
      return Result.Err(IoError.new(IoErrorKind.InvalidData, "bad request line"));
    },
  };

  switch (parts.get_ptr(1)) {
    .Some(_) => {},
    .None => {
      return Result.Err(IoError.new(IoErrorKind.InvalidData, "bad request line"));
    },
  };

  let method = parse_method(parts.get_ptr(0).unwrap());
  let path = parts.get_ptr(1).unwrap().clone();

  let headers = Headers { .inner = List#[Header].new() };
  let mut_headers = headers;
  let i: usize = 1;

  while (i < lines.len()) {
    switch (lines.get_ptr(i)) {
      .Some(line) => {
        let text = (*line).trim_end();

        if (text.len == 0) {
          break;
        };

        switch (find_colon(text)) {
          .Some(at) => {
            let vs = at + 1;
            mut_headers.push(String.from(trim_view(text.ptr, at)), String.from(trim_view(text.ptr + vs, text.len - vs)));
          },
          .None => {
            return Result.Err(IoError.new(IoErrorKind.InvalidData, "bad header line"));
          },
        };
      },
      .None => {},
    };

    i += 1;
  };

  let need: usize = 0;

  switch (mut_headers.get("content-length")) {
    .Some(raw) => {
      switch (parse_digits(&raw)) {
        .Some(n) => {
          need = n;
        },
        .None => {
          return Result.Err(IoError.new(IoErrorKind.InvalidData, "bad content length"));
        },
      };
    },
    .None => {},
  };

  let from: usize = 0;

  switch ((*head).find_str("\r\n\r\n")) {
    .Some(at) => {
      from = at + 4;
    },
    .None => {
      return Result.Err(IoError.new(IoErrorKind.InvalidData, "bad request"));
    },
  };
  let buffered = (*head).len() - from;
  let body = String.from((*head).slice(..)[from..(*head).len()]);

  if (buffered < need) {
    switch ((*stream).read_exact(&body, need - buffered)) {
      .Ok(_) => {},
      .Err(e) => {
        return Result.Err(e);
      },
    };
  };

  return Result.Ok(Request {
    .method = method,
    .path = path,
    .headers = mut_headers,
    .body = body,
  });
}

fn parse_method(token: *String) Method {
  if ((*token) == String.from("GET")) {
    return Method.Get;
  };

  if ((*token) == String.from("POST")) {
    return Method.Post;
  };

  if ((*token) == String.from("PUT")) {
    return Method.Put;
  };

  if ((*token) == String.from("DELETE")) {
    return Method.Delete;
  };

  if ((*token) == String.from("PATCH")) {
    return Method.Patch;
  };

  if ((*token) == String.from("HEAD")) {
    return Method.Head;
  };

  if ((*token) == String.from("OPTIONS")) {
    return Method.Options;
  };

  return Method.Unknown;
}

fn find_colon(s: []const char) Option[usize] {
  let i: usize = 0;

  while (i < s.len) {
    if (s.ptr[i] == ':') {
      return Option.Some(i);
    };

    i += 1;
  };

  return Option.None;
}

fn trim_view(ptr: [*]const char, len: usize) []const char {
  let start: usize = 0;

  while (start < len) {
    if (ptr[start] != ' ' && ptr[start] != '\t') {
      break;
    };

    start += 1;
  };

  let end = len;

  while (end > start) {
    if (ptr[end - 1] != ' ' && ptr[end - 1] != '\t') {
      break;
    };

    end -= 1;
  };

  ptr[start..end]
}

fn parse_digits(s: *const String) Option[usize] {
  if ((*s).len() == 0) {
    return Option.None;
  };

  let num: u32 = 0;
  let i: usize = 0;

  while (i < (*s).len()) {
    let d = @as(u32, (*s).get(i).unwrap());

    if (d < @as(u32, '0') || d > @as(u32, '9')) {
      return Option.None;
    };

    num = num * 10 + (d - @as(u32, '0'));
    i += 1;
  };

  return Option.Some(@as(usize, num));
}
