use std.alloc;
use std.collections.list;

const InitialSetCapacity: usize = 8;

fn next_pow2_set(n: usize) usize {
  let cap: usize = 1;
  while (cap < n) {
    cap <<= @as(usize, 1);
  };
  cap
}

fn set_bucket_index(hash: u64, cap: usize) usize {
  @as(usize, hash % @as(u64, cap))
}

fn set_find_in_bucket[T: Hash + Eq](bucket: *List[SetEntry[T]], key: *const T, hash: u64) Option[usize] {
  let len = bucket.len();
  let idx: usize = 0;

  while (idx < len) {
    switch (bucket.get_ptr(idx)) {
      .Some(entry) => if ((*entry).hash == hash && (*entry).key == *key) {
        return Option.Some(idx);
      },
      .None => {},
    };

    idx += 1;
  };

  return Option.None;
}

pub struct SetEntry[T] {
  pub hash: u64,
  pub key: T,
}

pub struct HashSet[T: Hash + Eq] {
  buckets: List[List[SetEntry[T]]>,
  _len: usize,
  _capacity: usize,

  pub fn new() Self {
    let cap = InitialSetCapacity;
    let buckets = List#[List[SetEntry[T]]].with_capacity(cap);

    let idx: usize = 0;
    while (idx < cap) {
      buckets.push(List#[SetEntry[T]].new());
      idx += 1;
    };

    Self {
      .buckets = buckets,
      ._len = 0,
      ._capacity = cap,
    }
  }

  pub fn with_capacity(cap: usize) Self {
    let cap = next_pow2_set(if (cap < InitialSetCapacity) { InitialSetCapacity } else { cap });
    let buckets = List#[List[SetEntry[T]]].with_capacity(cap);

    let idx: usize = 0;
    while (idx < cap) {
      buckets.push(List#[SetEntry[T]].new());
      idx += 1;
    };

    Self {
      .buckets = buckets,
      ._len = 0,
      ._capacity = cap,
    }
  }

  pub fn len(*const self) usize {
    self._len
  }

  pub fn is_empty(*const self) bool {
    self._len == 0
  }

  pub fn capacity(*const self) usize {
    self._capacity
  }

  pub fn clear(*self) {
    let idx: usize = 0;

    while (idx < self._capacity) {
      switch (self.buckets.get_ptr(idx)) {
        .Some(bucket) => (*bucket).clear(),
        .None => {},
      };

      idx += 1;
    };

    self._len = 0;
  }

  pub fn contains(*const self, value: *const T) bool {
    if (self._capacity == 0) {
      return false;
    };
    let h = (*value).hash();
    let idx = set_bucket_index(h, self._capacity);
    switch (self.buckets.get_ptr(idx)) {
      .Some(b) => {
        switch (set_find_in_bucket(b, value, h)) {
          .Some(_) => true,
          .None => false,
        }
      },
      .None => false,
    }
  }

  pub fn get(*const self, value: *const T) Option[*const T] {
    if (self._capacity == 0) {
      return Option.None;
    };

    let hash = (*value).hash();
    let idx = set_bucket_index(hash, self._capacity);

    switch (self.buckets.get_ptr(idx)) {
      .Some(bucket) => {
        switch (set_find_in_bucket(bucket, value, hash)) {
          .Some(pos) => {
            switch (bucket.get_ptr(pos)) {
              .Some(entry) => Option.Some(&(*entry).key),
              .None => Option.None,
            }
          },
          .None => Option.None,
        }
      },
      .None => Option.None,
    }
  }

  pub fn insert(*self, value: T) bool {
    if (self._capacity == 0) {
      let new_buckets = List#[List[SetEntry[T]]].with_capacity(InitialSetCapacity);

      let idx: usize = 0;
      while (idx < InitialSetCapacity) {
        new_buckets.push(List#[SetEntry[T]].new());
        idx += 1;
      };

      self.buckets = new_buckets;
      self._capacity = InitialSetCapacity;
    };

    let hash = value.hash();
    let idx = set_bucket_index(hash, self._capacity);

    switch (self.buckets.get_ptr(idx)) {
      .Some(bucket) => {
        switch (set_find_in_bucket(bucket, &value, hash)) {
          .Some(_) => {
            let _drop = value;
            return false;
          },
          .None => {},
        };

        bucket.push(SetEntry { .hash = hash, .key = value });
        self._len += 1;

        if (self._len * @as(usize, 4) > self._capacity * @as(usize, 3)) {
          self.grow();
        };

        return true;
      },
      .None => false,
    }
  }

  fn grow(*self) {
    let new_cap = self._capacity * @as(usize, 2);
    let new_buckets = List#[List[SetEntry[T]]].with_capacity(new_cap);

    let idx: usize = 0;
    while (idx < new_cap) {
      new_buckets.push(List#[SetEntry[T]].new());
      idx += 1;
    };

    let outer: usize = 0;
    while (outer < self._capacity) {
      switch (self.buckets.get_ptr(outer)) {
        .Some(bucket) => {
          while (!bucket.is_empty()) {
            switch (bucket.pop()) {
              .Some(entry) => {
                let new_idx = set_bucket_index(entry.hash, new_cap);

                switch (new_buckets.get_ptr(new_idx)) {
                  .Some(dest) => dest.push(entry),
                  .None => {},
                };
              },
              .None => {},
            };
          };
        },
        .None => {},
      };

      outer += 1;
    };

    self.buckets = new_buckets;
    self._capacity = new_cap;
  }

  pub fn remove(*self, value: *const T) bool {
    if (self._capacity == 0) {
      return false;
    };

    let hash = (*value).hash();
    let idx = set_bucket_index(hash, self._capacity);

    switch (self.buckets.get_ptr(idx)) {
      .Some(bucket) => {
        switch (set_find_in_bucket(bucket, value, hash)) {
          .Some(pos) => {
            switch (bucket.remove(pos)) {
              .Some(entry) => {
                self._len -= 1;

                let _drop = entry.key;
                return true;
              },
              .None => false,
            }
          },
          .None => false,
        }
      },
      .None => false,
    }
  }
}

implement[T: Hash + Eq] Drop : HashSet[T] {
  fn drop(self) {
    self.clear();
  }
}

implement[T: Hash + Eq + Clone] Clone : HashSet[T] {
  fn clone(*const self) Self {
    let out = HashSet#[T].with_capacity(self._capacity);

    let idx: usize = 0;
    while (idx < self._capacity) {
      switch (self.buckets.get_ptr(idx)) {
        .Some(bucket) => {
          let pos: usize = 0;

          while (pos < bucket.len()) {
            switch (bucket.get_ptr(pos)) {
              .Some(entry) => {
                out.insert((*entry).key.clone());
              },
              .None => {},
            };

            pos += 1;
          };
        },
        .None => {},
      };

      idx += 1;
    };

    out
  }
}
