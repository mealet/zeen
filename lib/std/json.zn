use std.string;
use std.collections.list;
use std.collections.map;

const MaxJsonDepth: usize = 128;

/// JSON parse error.
pub struct JsonError {
  pub kind: JsonErrorKind,
  pub pos: usize,
}

/// JSON parse error kinds.
pub enum JsonErrorKind {
  UnexpectedChar,
  UnexpectedEnd,
  TrailingData,
  DepthExceeded,
  InvalidNumber,
  InvalidEscape,
}

/// JSON value, numbers kept as raw text.
pub enum JsonValue {
  Null,
  Bool: bool,
  Num: String,
  Str: String,
  Array: List[JsonValue],
  Object: JsonObject,

  /// Parse a JSON document.
  pub fn parse(text: []const char) Result[JsonValue, JsonError] {
    let parser = JsonParser { .text = text, .pos = 0 };
    parser.skip_ws();

    let parsed = parser.parse_value(0);
    if (parsed.is_err()) {
      return Result.Err(parsed.unwrap_err());
    };

    parser.skip_ws();
    if (parser.pos != text.len) {
      return Result.Err(JsonError { .kind = JsonErrorKind.TrailingData, .pos = parser.pos });
    };

    return Result.Ok(parsed.unwrap());
  }

  /// Render compact JSON text.
  pub fn stringify(*const self) String {
    let out = String.new();
    self.write_into(&out);
    return out;
  }

  /// Object member by key, `None` outside objects.
  pub fn get(*const self, key: []const char) Option[*const JsonValue] {
    return switch (*self) {
      .Object(&obj) => obj.get(key),
      _ => Option.None,
    };
  }

  /// Array element by index, `None` outside arrays.
  pub fn at(*const self, index: usize) Option[*const JsonValue] {
    return switch (*self) {
      .Array(&items) => JsonValue.at_index(items, index),
      _ => Option.None,
    };
  }

  fn at_index(items: *const List[JsonValue], index: usize) Option[*const JsonValue] {
    let found = items.get_ptr(index);
    if (found.is_none()) {
      return Option.None;
    };
    let slot: *const JsonValue = found.unwrap();
    return Option.Some(slot);
  }

  /// Element count of arrays and objects, zero otherwise.
  pub fn len(*const self) usize {
    return switch (*self) {
      .Array(&items) => items.len(),
      .Object(&obj) => obj.len(),
      _ => 0,
    };
  }

  pub fn is_null(*const self) bool {
    return switch (*self) {
      .Null => true,
      _ => false,
    };
  }

  pub fn is_bool(*const self) bool {
    return self.as_bool().is_some();
  }

  pub fn is_num(*const self) bool {
    return self.as_num().is_some();
  }

  pub fn is_str(*const self) bool {
    return self.as_str().is_some();
  }

  pub fn is_array(*const self) bool {
    return switch (*self) {
      .Array(&items) => true,
      _ => false,
    };
  }

  pub fn is_object(*const self) bool {
    return switch (*self) {
      .Object(&obj) => true,
      _ => false,
    };
  }

  pub fn as_bool(*const self) Option[bool] {
    return switch (*self) {
      .Bool(value) => Option.Some(value),
      _ => Option.None,
    };
  }

  pub fn as_num(*const self) Option[String] {
    return switch (*self) {
      .Num(&text) => Option.Some(text.clone()),
      _ => Option.None,
    };
  }

  pub fn as_i64(*const self) Option[i64] {
    let text = self.as_num();
    if (text.is_none()) {
      return Option.None;
    };
    return text.unwrap().parse_i64();
  }

  pub fn as_f64(*const self) Option[f64] {
    let text = self.as_num();
    if (text.is_none()) {
      return Option.None;
    };
    return text.unwrap().parse_f64();
  }

  pub fn as_str(*const self) Option[String] {
    return switch (*self) {
      .Str(&text) => Option.Some(text.clone()),
      _ => Option.None,
    };
  }

  pub fn write_into(*const self, out: *String) {
    switch (*self) {
      .Null => {
        out.push_str("null");
      },
      .Bool(value) => {
        if (value) {
          out.push_str("true");
        } else {
          out.push_str("false");
        };
      },
      .Num(&text) => {
        text.display(out);
      },
      .Str(&text) => {
        JsonValue.write_string(out, text);
      },
      .Array(&items) => {
        out.push('[');
        let i: usize = 0;
        while (i < items.len()) {
          if (i != 0) {
            out.push(',');
          };
          let elem = items.get_ptr(i).unwrap();
          elem.write_into(out);
          i += 1;
        }
        out.push(']');
      },
      .Object(&obj) => {
        obj.write_into(out);
      },
    };
  }

  pub fn write_string(out: *String, text: *String) {
    let hex: []const char = "0123456789abcdef";
    out.push('"');

    let i: usize = 0;
    while (i < text.len()) {
      let c = text.get(i).unwrap();
      if (c == '"') {
        out.push(@as(char, 92));
        out.push('"');
      } else if (c == @as(char, 92)) {
        out.push(@as(char, 92));
        out.push(@as(char, 92));
      } else if (c == @as(char, 8)) {
        out.push(@as(char, 92));
        out.push('b');
      } else if (c == @as(char, 12)) {
        out.push(@as(char, 92));
        out.push('f');
      } else if (c == @as(char, 10)) {
        out.push(@as(char, 92));
        out.push('n');
      } else if (c == @as(char, 13)) {
        out.push(@as(char, 92));
        out.push('r');
      } else if (c == @as(char, 9)) {
        out.push(@as(char, 92));
        out.push('t');
      } else if (@as(u32, c) < 32) {
        out.push(@as(char, 92));
        out.push('u');
        out.push('0');
        out.push('0');
        out.push(hex[@as(usize, @as(u32, c) >> 4)]);
        out.push(hex[@as(usize, @as(u32, c) & 15)]);
      } else {
        out.push(c);
      };
      i += 1;
    }

    out.push('"');
  }
}

/// Insertion-ordered object backing, fast lookup inside.
struct JsonObject {
  map: HashMap[String, JsonValue],
  keys: List[String],

  pub fn new() Self {
    return JsonObject { .map = HashMap#[String, JsonValue].new(), .keys = List#[String].new() };
  }

  pub fn insert(*self, key: String, value: JsonValue) {
    if (!self.map.contains_key(&key)) {
      self.keys.push(key.clone());
    };
    let _ = self.map.insert(key, value);
  }

  pub fn get(*const self, key: []const char) Option[*const JsonValue] {
    let owned = String.from(key);
    return self.map.get(&owned);
  }

  pub fn key_at(*const self, index: usize) *String {
    return self.keys.get_ptr(index).unwrap();
  }

  pub fn get_at(*const self, index: usize) *const JsonValue {
    let key = self.key_at(index);
    return self.map.get(key).unwrap();
  }

  pub fn len(*const self) usize {
    return self.keys.len();
  }

  pub fn write_into(*const self, out: *String) {
    out.push('{');
    let i: usize = 0;
    while (i < self.keys.len()) {
      if (i != 0) {
        out.push(',');
      };
      let key = self.key_at(i);
      JsonValue.write_string(out, key);
      out.push(':');
      let value = self.get_at(i);
      value.write_into(out);
      i += 1;
    }
    out.push('}');
  }
}

struct JsonParser {
  pub text: []const char,
  pub pos: usize,

  fn peek(*const self) Option[char] {
    if (self.pos >= self.text.len) {
      return Option.None;
    };
    return Option.Some(self.text[self.pos]);
  }

  fn peek_is(*const self, want: char) bool {
    let c = self.peek();
    if (c.is_none()) {
      return false;
    };
    return c.unwrap() == want;
  }

  pub fn skip_ws(*self) {
    while (self.pos < self.text.len) {
      let ch = self.text[self.pos];
      if (ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r') {
        self.pos += 1;
      } else {
        return;
      };
    }
  }

  pub fn parse_value(*self, depth: usize) Result[JsonValue, JsonError] {
    if (depth > MaxJsonDepth) {
      return Result.Err(JsonError { .kind = JsonErrorKind.DepthExceeded, .pos = self.pos });
    };

    self.skip_ws();
    let head = self.peek();
    if (head.is_none()) {
      return Result.Err(JsonError { .kind = JsonErrorKind.UnexpectedEnd, .pos = self.pos });
    };

    let ch = head.unwrap();
    if (ch == '{') {
      return self.parse_object(depth);
    };
    if (ch == '[') {
      return self.parse_array(depth);
    };
    if (ch == '"') {
      let text = self.parse_string();
      if (text.is_err()) {
        return Result.Err(text.unwrap_err());
      };
      return Result.Ok(JsonValue.Str(text.unwrap()));
    };
    if (ch == 't') {
      return self.parse_literal("true", JsonValue.Bool(true));
    };
    if (ch == 'f') {
      return self.parse_literal("false", JsonValue.Bool(false));
    };
    if (ch == 'n') {
      return self.parse_literal("null", JsonValue.Null);
    };
    if (ch == '-' || JsonParser.is_digit(ch)) {
      return self.parse_number();
    };

    return Result.Err(JsonError { .kind = JsonErrorKind.UnexpectedChar, .pos = self.pos });
  }

  fn parse_literal(*self, word: []const char, value: JsonValue) Result[JsonValue, JsonError] {
    let i: usize = 0;
    while (i < word.len) {
      let c = self.peek();
      if (c.is_none() || c.unwrap() != word[i]) {
        return Result.Err(JsonError { .kind = JsonErrorKind.UnexpectedChar, .pos = self.pos });
      };
      self.pos += 1;
      i += 1;
    }
    return Result.Ok(value);
  }

  fn parse_array(*self, depth: usize) Result[JsonValue, JsonError] {
    self.pos += 1;
    let out = List#[JsonValue].new();

    self.skip_ws();
    if (self.peek_is(']')) {
      self.pos += 1;
      return Result.Ok(JsonValue.Array(out));
    };

    while (self.pos < self.text.len) {
      let item = self.parse_value(depth + 1);
      if (item.is_err()) {
        return Result.Err(item.unwrap_err());
      };
      out.push(item.unwrap());

      self.skip_ws();
      if (self.peek_is(',')) {
        self.pos += 1;
        self.skip_ws();
        continue;
      };
      if (self.peek_is(']')) {
        self.pos += 1;
        return Result.Ok(JsonValue.Array(out));
      };
      return Result.Err(JsonError { .kind = JsonErrorKind.UnexpectedChar, .pos = self.pos });
    }

    return Result.Err(JsonError { .kind = JsonErrorKind.UnexpectedEnd, .pos = self.pos });
  }

  fn parse_object(*self, depth: usize) Result[JsonValue, JsonError] {
    self.pos += 1;
    let out = JsonObject.new();

    self.skip_ws();
    if (self.peek_is('}')) {
      self.pos += 1;
      return Result.Ok(JsonValue.Object(out));
    };

    while (self.pos < self.text.len) {
      self.skip_ws();
      if (!self.peek_is('"')) {
        return Result.Err(JsonError { .kind = JsonErrorKind.UnexpectedChar, .pos = self.pos });
      };
      let key = self.parse_string();
      if (key.is_err()) {
        return Result.Err(key.unwrap_err());
      };

      self.skip_ws();
      if (!self.peek_is(':')) {
        return Result.Err(JsonError { .kind = JsonErrorKind.UnexpectedChar, .pos = self.pos });
      };
      self.pos += 1;
      self.skip_ws();

      let value = self.parse_value(depth + 1);
      if (value.is_err()) {
        return Result.Err(value.unwrap_err());
      };
      out.insert(key.unwrap(), value.unwrap());

      self.skip_ws();
      if (self.peek_is(',')) {
        self.pos += 1;
        continue;
      };
      if (self.peek_is('}')) {
        self.pos += 1;
        return Result.Ok(JsonValue.Object(out));
      };
      return Result.Err(JsonError { .kind = JsonErrorKind.UnexpectedChar, .pos = self.pos });
    }

    return Result.Err(JsonError { .kind = JsonErrorKind.UnexpectedEnd, .pos = self.pos });
  }

  fn parse_string(*self) Result[String, JsonError] {
    self.pos += 1;
    let out = String.new();

    while (self.pos < self.text.len) {
      let ch = self.text[self.pos];
      if (ch == '"') {
        self.pos += 1;
        return Result.Ok(out);
      };

      if (@as(u32, ch) == 92) {
        self.pos += 1;
        let esc = self.parse_escape();
        if (esc.is_err()) {
          return Result.Err(esc.unwrap_err());
        };
        out.push(esc.unwrap());
        continue;
      };

      if (@as(u32, ch) < 32) {
        return Result.Err(JsonError { .kind = JsonErrorKind.UnexpectedChar, .pos = self.pos });
      };

      out.push(ch);
      self.pos += 1;
    }

    return Result.Err(JsonError { .kind = JsonErrorKind.UnexpectedEnd, .pos = self.pos });
  }

  fn parse_escape(*self) Result[char, JsonError] {
    let head = self.peek();
    if (head.is_none()) {
      return Result.Err(JsonError { .kind = JsonErrorKind.UnexpectedEnd, .pos = self.pos });
    };

    let ch = head.unwrap();
    self.pos += 1;

    if (ch == '"') {
      return Result.Ok('"');
    };
    if (ch == @as(char, 92)) {
      return Result.Ok(@as(char, 92));
    };
    if (ch == '/') {
      return Result.Ok('/');
    };
    if (ch == 'b') {
      return Result.Ok(@as(char, 8));
    };
    if (ch == 'f') {
      return Result.Ok(@as(char, 12));
    };
    if (ch == 'n') {
      return Result.Ok(@as(char, 10));
    };
    if (ch == 'r') {
      return Result.Ok(@as(char, 13));
    };
    if (ch == 't') {
      return Result.Ok(@as(char, 9));
    };
    if (ch == 'u') {
      return self.parse_unicode();
    };
    return Result.Err(JsonError { .kind = JsonErrorKind.InvalidEscape, .pos = self.pos });
  }

  fn parse_unicode(*self) Result[char, JsonError] {
    let hi = self.parse_hex4();
    if (hi.is_err()) {
      return Result.Err(hi.unwrap_err());
    };
    let high = hi.unwrap();

    if (high >= 55296 && high <= 57343) {
      return Result.Err(JsonError { .kind = JsonErrorKind.InvalidEscape, .pos = self.pos });
    };
    if (high > 255) {
      return Result.Err(JsonError { .kind = JsonErrorKind.InvalidEscape, .pos = self.pos });
    };

    return Result.Ok(@as(char, high));
  }

  fn parse_hex4(*self) Result[u32, JsonError] {
    let value: u32 = 0;
    let i: i32 = 0;
    while (i < 4) {
      let head = self.peek();
      if (head.is_none()) {
        return Result.Err(JsonError { .kind = JsonErrorKind.UnexpectedEnd, .pos = self.pos });
      };
      let digit = JsonParser.hex_value(head.unwrap());
      if (digit.is_none()) {
        return Result.Err(JsonError { .kind = JsonErrorKind.InvalidEscape, .pos = self.pos });
      };
      value = value * 16 + digit.unwrap();
      self.pos += 1;
      i += 1;
    }
    return Result.Ok(value);
  }

  fn hex_value(c: char) Option[u32] {
    let code = @as(u32, c);
    if (code >= @as(u32, '0') && code <= @as(u32, '9')) {
      return Option.Some(code - @as(u32, '0'));
    };
    if (code >= @as(u32, 'a') && code <= @as(u32, 'f')) {
      return Option.Some(code - @as(u32, 'a') + 10);
    };
    if (code >= @as(u32, 'A') && code <= @as(u32, 'F')) {
      return Option.Some(code - @as(u32, 'A') + 10);
    };
    return Option.None;
  }

  fn parse_number(*self) Result[JsonValue, JsonError] {
    let start = self.pos;

    if (self.peek_is('-')) {
      self.pos += 1;
    };

    if (!self.take_int_part()) {
      return Result.Err(JsonError { .kind = JsonErrorKind.InvalidNumber, .pos = start });
    };

    if (self.peek_is('.')) {
      self.pos += 1;
      if (!self.take_digits()) {
        return Result.Err(JsonError { .kind = JsonErrorKind.InvalidNumber, .pos = start });
      };
    };

    let mark = self.peek();
    if (mark.is_some() && (mark.unwrap() == 'e' || mark.unwrap() == 'E')) {
      self.pos += 1;
      if (self.peek_is('-') || self.peek_is('+')) {
        self.pos += 1;
      };
      if (!self.take_digits()) {
        return Result.Err(JsonError { .kind = JsonErrorKind.InvalidNumber, .pos = start });
      };
    };

    return Result.Ok(JsonValue.Num(String.from(self.text[start..self.pos])));
  }

  fn take_int_part(*self) bool {
    let c = self.peek();
    if (c.is_none()) {
      return false;
    };
    if (c.unwrap() == '0') {
      self.pos += 1;
      return true;
    };
    return self.take_digits();
  }

  fn take_digits(*self) bool {
    let start = self.pos;
    while (self.pos < self.text.len) {
      let c = self.text[self.pos];
      if (!JsonParser.is_digit(c)) {
        break;
      };
      self.pos += 1;
    }
    return self.pos > start;
  }

  fn is_digit(c: char) bool {
    let code = @as(u32, c);
    return code >= @as(u32, '0') && code <= @as(u32, '9');
  }
}
