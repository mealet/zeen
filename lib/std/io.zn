use std.alloc;
use std.string;
use std.c.stdio;
use std.c.string;
use std.c.errno;

/// IO error kind, mirroring Rust `std::io::ErrorKind`.
pub enum IoErrorKind {
  NotFound,
  PermissionDenied,
  AlreadyExists,
  InvalidInput,
  InvalidData,
  UnexpectedEof,
  WriteZero,
  Interrupted,
  WouldBlock,
  TimedOut,
  BrokenPipe,
  IsADirectory,
  NotADirectory,
  Unsupported,
  OutOfMemory,
  Uncategorized,
}

/// IO error with a kind and a human readable message.
pub struct IoError {
  _kind: IoErrorKind,
  _message: String,

  pub fn new(kind: IoErrorKind, message: []const char) Self {
    Self {
      ._kind = kind,
      ._message = String.from(message),
    }
  }

  pub fn kind(*const self) IoErrorKind {
    self._kind
  }

  pub fn message(self) String {
    self._message
  }

  pub fn from_errno(code: c_int) Self {
    let kind = IoErrorKind.Uncategorized;

    if (code == ENOENT) {
      kind = IoErrorKind.NotFound;
    } else if (code == EACCES || code == EPERM) {
      kind = IoErrorKind.PermissionDenied;
    } else if (code == EEXIST) {
      kind = IoErrorKind.AlreadyExists;
    } else if (code == EINVAL) {
      kind = IoErrorKind.InvalidInput;
    } else if (code == EPIPE) {
      kind = IoErrorKind.BrokenPipe;
    } else if (code == EINTR) {
      kind = IoErrorKind.Interrupted;
    } else if (code == EAGAIN) {
      kind = IoErrorKind.WouldBlock;
    } else if (code == ENOMEM) {
      kind = IoErrorKind.OutOfMemory;
    } else if (code == EISDIR) {
      kind = IoErrorKind.IsADirectory;
    } else if (code == ENOTDIR) {
      kind = IoErrorKind.NotADirectory;
    } else if (code == ENOSYS) {
      kind = IoErrorKind.Unsupported;
    } else if (code == EILSEQ) {
      kind = IoErrorKind.InvalidData;
    };

    Self {
      ._kind = kind,
      ._message = String.from_cstr(@as([*]char, strerror(code))),
    }
  }

  pub fn last_os_error() Self {
    @os[windows] {
      return Self.new(IoErrorKind.Unsupported, "os error codes are not supported on windows");
    } else {
      let slot = __errno_location();
      return Self.from_errno(*slot);
    }
  }
}

/// Standard input handle.
pub struct Stdin {
  /// Read one line, keeping trailing newline.
  pub fn read_line(buf: *String) bool {
    @os[windows] {
      let ok = read_line_fgets(buf);
    } else {
      let ok = read_line_getline(buf);
    }

    ok
  }

  /// Read whole input into buffer.
  pub fn read_to_string(buf: *String) bool {
    let any = false;

    while (Stdin.read_line(buf)) {
      any = true;
    };

    any
  }

  /// Read exactly `n` bytes, appending to buffer.
  /// Returns `true` when all bytes read, `false` on end or error.
  pub fn read_exact(buf: *String, n: usize) bool {
    let chunk: [256]char = @uninit();
    let need = n;

    while (need > 0) {
      let take: usize = 256;

      if (need < take) {
        take = need;
      };

      let got = fread(@as(*void, &chunk[0]), 1, take, stdin);

      if (got == 0) {
        return false;
      };

      (*buf).push_str(chunk[0..got]);
      need -= got;
    };

    true
  }
}

/// Line reader through `getline` (posix).
@os[linux | android | darwin | freebsd] {
  fn read_line_getline(buf: *String) bool {
    let line: *char = @as(*char, nullptr);
    let cap: usize = 0;

    let n = getline(@as(**char, &line), @as(*usize, &cap), stdin);

    if (n < 0) {
      return false;
    };

    (*buf).push_str((@as([*]char, line))[0..@as(usize, n)]);
    Allocator.dealloc(@as(*void, line));

    true
  }
}

/// Line reader through `fgets` chunks (no `getline` here).
@os[windows] {
  fn read_line_fgets(buf: *String) bool {
    let chunk: [256]char = @uninit();
    let any = false;

    while (true) {
      let got = fgets(chunk, 256, stdin);

      if (@as(*void, got) == nullptr) {
        break;
      };

      any = true;

      let i: usize = 0;
      while (i < 256) {
        if (chunk[i] == '\0') {
          break;
        };

        (*buf).push(chunk[i]);

        if (chunk[i] == '\n') {
          return true;
        };

        i += 1;
      };
    };

    any
  }
}

/// Standard output handle.
pub struct Stdout {
  /// Write string slice to output.
  pub fn write(value: []const char) void {
    let out = OutStream {};
    out.write_str(value);
  }

  /// Write string to output.
  pub fn write_string(value: *String) void {
    Stdout.write((*value).slice(..));
  }

  /// Flush output buffer.
  pub fn flush() void {
    let _ = fflush(stdout);
  }
}

/// Standard error handle.
pub struct Stderr {
  /// Write string slice to error output.
  pub fn write(value: []const char) void {
    let _ = fwrite(@as([*]const void, value.ptr), 1, value.len, stderr);
  }

  /// Flush error output.
  pub fn flush() void {
    let _ = fflush(stderr);
  }
}
