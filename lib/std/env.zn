use std.alloc;
use std.string;
use std.collections.list;
use std.io;
use std.c.types;
use std.c.stdlib;

@os[windows] {
  use std.c.windows.winbase;
  use std.c.windows.libloaderapi;
} else {
  use std.c.posix.unistd;
}

/// Environment variable entry.
pub struct EnvVar {
  pub key: String,
  pub value: String,
}

/// OS environment: variables, directories and executable path.
pub struct Env {
  /// Value of the variable, `None` when missing or unreadable.
  pub fn var(name: []const char) Option[String] {
    let c = String.from(name);
    c.push('\0');

    let raw = getenv(@as([*]const char, c.slice(..).ptr));
    if (raw == nullptr) {
      return Option.None;
    };

    return Option.Some(String.from_cstr(@as([*]const char, raw)));
  }

  /// Set the variable for the current process.
  pub fn set_var(name: []const char, value: []const char) Result[void, IoError] {
    let kn = String.from(name);
    kn.push('\0');
    let vn = String.from(value);
    vn.push('\0');

    @os[windows] {
      let ok = SetEnvironmentVariableA(
        @as([*]const c_char, kn.slice(..).ptr),
        @as([*]const c_char, vn.slice(..).ptr),
      );
      if (ok == 0) {
        return Result.Err(IoError.last_os_error());
      };
    } else {
      let rc = setenv(
        @as([*]const char, kn.slice(..).ptr),
        @as([*]const char, vn.slice(..).ptr),
        1,
      );
      if (rc != 0) {
        return Result.Err(IoError.last_os_error());
      };
    }

    return Result.Ok(@void());
  }

  /// Remove the variable from the current process.
  pub fn unset_var(name: []const char) Result[void, IoError] {
    let kn = String.from(name);
    kn.push('\0');

    @os[windows] {
      let ok = SetEnvironmentVariableA(@as([*]const c_char, kn.slice(..).ptr), nullptr);
      if (ok == 0) {
        return Result.Err(IoError.last_os_error());
      };
    } else {
      let rc = unsetenv(@as([*]const char, kn.slice(..).ptr));
      if (rc != 0) {
        return Result.Err(IoError.last_os_error());
      };
    }

    return Result.Ok(@void());
  }

  /// Snapshot of all variables of the current process.
  pub fn vars() List[EnvVar] {
    let out = List#[EnvVar].new();

    @os[windows] {
      let block = GetEnvironmentStringsA();
      if (block == nullptr) {
        return out;
      };

      let cur = block;
      while (cur[0] != @as(c_char, 0)) {
        Env.push_entry(&out, String.from_cstr(@as([*]const char, cur)));
        cur = cur + Env.entry_len(cur) + 1;
      }

      FreeEnvironmentStringsA(block);
    } else {
      let i: i32 = 0;
      while (true) {
        let entry = environ[@as(usize, i)];
        if (entry == nullptr) {
          break;
        };

        Env.push_entry(&out, String.from_cstr(@as([*]const char, entry)));
        i += 1;
      }
    }

    return out;
  }

  fn push_entry(out: *List[EnvVar], text: String) {
    let cut = text.find('=');
    if (cut.is_none()) {
      return;
    };

    let pos = cut.unwrap();
    let rest = pos + 1;
    let key = String.from(text[0..pos]);
    let value = String.from(text[rest..text.len()]);
    out.push(EnvVar { .key = key, .value = value });
  }

  fn entry_len(entry: [*]c_char) usize {
    let n: usize = 0;
    while (entry[n] != @as(c_char, 0)) {
      n += 1;
    }
    return n;
  }

  /// Current working directory.
  pub fn current_dir() Result[String, IoError] {
    @os[windows] {
      let buf = Allocator.alloc(4096);
      let n = GetCurrentDirectoryA(4096, @as([*]char, buf));

      if (n == 0) {
        Allocator.dealloc(buf);
        return Result.Err(IoError.last_os_error());
      };

      let out = String.from_cstr(@as([*]const char, buf));
      Allocator.dealloc(buf);
      return Result.Ok(out);
    } else {
      let buf = Allocator.alloc(4096);
      let res = getcwd(@as([*]char, buf), 4096);

      if (@as(*void, res) == nullptr) {
        Allocator.dealloc(buf);
        return Result.Err(IoError.last_os_error());
      };

      let out = String.from_cstr(@as([*]const char, buf));
      Allocator.dealloc(buf);
      return Result.Ok(out);
    }
  }

  /// Change the current working directory.
  pub fn set_current_dir(path: []const char) Result[void, IoError] {
    let c = String.from(path);
    c.push('\0');

    @os[windows] {
      let ok = SetCurrentDirectoryA(@as([*]const c_char, c.slice(..).ptr));
      if (ok == 0) {
        return Result.Err(IoError.last_os_error());
      };
    } else {
      let rc = chdir(@as([*]const char, c.slice(..).ptr));
      if (rc != 0) {
        return Result.Err(IoError.last_os_error());
      };
    }

    return Result.Ok(@void());
  }

  /// Full path of the current executable.
  pub fn current_exe() Result[String, IoError] {
    @os[windows] {
      let buf = Allocator.alloc(4096);
      let n = GetModuleFileNameA(nullptr, @as([*]c_char, buf), 4096);

      if (n == 0) {
        Allocator.dealloc(buf);
        return Result.Err(IoError.last_os_error());
      };

      let out = String.from_cstr(@as([*]const char, buf));
      Allocator.dealloc(buf);
      return Result.Ok(out);
    } else {
      let buf = Allocator.alloc(4096);
      let path = String.from("/proc/self/exe");
      path.push('\0');

      let rc = readlink(
        @as([*]const char, path.slice(..).ptr),
        @as([*]char, buf),
        4096,
      );
      if (rc < 0) {
        Allocator.dealloc(buf);
        return Result.Err(IoError.last_os_error());
      };

      (@as([*]char, buf))[@as(usize, rc)] = '\0';

      let out = String.from_cstr(@as([*]const char, buf));
      Allocator.dealloc(buf);
      return Result.Ok(out);
    }
  }

  /// Directory for temporary files.
  pub fn temp_dir() String {
    @os[windows] {
      let t = Env.var("TEMP");
      if (t.is_some()) {
        return t.unwrap();
      };

      let u = Env.var("TMP");
      if (u.is_some()) {
        return u.unwrap();
      };

      return String.from("C:/Windows/Temp");
    } else {
      let t = Env.var("TMPDIR");
      if (t.is_some()) {
        return t.unwrap();
      };

      return String.from("/tmp");
    }
  }
}
