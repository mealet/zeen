use std.c.types;

pub struct c_FILE {}

// standard streams
pub extern let stdin: *c_FILE;
pub extern let stdout: *c_FILE;
pub extern let stderr: *c_FILE;

// file operations
pub extern fn fopen(filename: [*]const char, mode: [*]const char) *c_FILE;
pub extern fn freopen(filename: [*]const char, mode: [*]const char, stream: *c_FILE) *c_FILE;
pub extern fn fclose(stream: *c_FILE) c_int;
pub extern fn fflush(stream: *c_FILE) c_int;
pub extern fn remove(filename: [*]const char) c_int;
pub extern fn rename(old_name: [*]const char, new_name: [*]const char) c_int;

// formatted I/O
pub extern fn printf(fmt: [*]const char, ...) c_int;
pub extern fn fprintf(stream: *c_FILE, fmt: [*]const char, ...) c_int;
pub extern fn sprintf(buf: [*]char, fmt: [*]const char, ...) c_int;
pub extern fn snprintf(buf: [*]char, n: c_size_t, fmt: [*]const char, ...) c_int;
pub extern fn scanf(fmt: [*]const char, ...) c_int;
pub extern fn fscanf(stream: *c_FILE, fmt: [*]const char, ...) c_int;
pub extern fn sscanf(str: [*]const char, fmt: [*]const char, ...) c_int;

// char I/O
pub extern fn fgetc(stream: *c_FILE) c_int;
pub extern fn getc(stream: *c_FILE) c_int;
pub extern fn getchar() c_int;
pub extern fn fputc(ch: c_int, stream: *c_FILE) c_int;
pub extern fn putc(ch: c_int, stream: *c_FILE) c_int;
pub extern fn putchar(ch: c_int) c_int;
pub extern fn ungetc(ch: c_int, stream: *c_FILE) c_int;

// line / block I/O
pub extern fn fgets(buf: [*]char, n: c_int, stream: *c_FILE) *char;
pub extern fn fputs(str: [*]const char, stream: *c_FILE) c_int;
pub extern fn puts(str: [*]const char) c_int;
pub extern fn fread(ptr: *void, size: c_size_t, count: c_size_t, stream: *c_FILE) c_size_t;
pub extern fn fwrite(ptr: [*]const void, size: c_size_t, count: c_size_t, stream: *c_FILE) c_size_t;

// positioning
pub extern fn fseek(stream: *c_FILE, offset: c_long, origin: c_int) c_int;
pub extern fn ftell(stream: *c_FILE) c_long;
pub extern fn rewind(stream: *c_FILE) void;

// error handling
pub extern fn feof(stream: *c_FILE) c_int;
pub extern fn ferror(stream: *c_FILE) c_int;
pub extern fn clearerr(stream: *c_FILE) void;
pub extern fn perror(str: [*]const char) void;

// buffering mode flags (_IOFBF=0, _IOLBF=1, _IONBF=2; identical everywhere)
pub const _IOFBF: c_int = 0;
pub const _IOLBF: c_int = 1;
pub const _IONBF: c_int = 2;

@os[linux] {
  // BUFSIZ for glibc
  pub const BUFSIZ: c_int = 8192;
} else {
  // BUFSIZ for musl/android/bsd/darwin
  pub const BUFSIZ: c_int = 1024;
}

// POSIX stdio extensions (stddio.h + sys/stdio.h + stdio_ext.h).
@os[linux | android | darwin | freebsd] {
  pub extern fn fileno(stream: *c_FILE) c_int;
  pub extern fn fdopen(fd: c_int, mode: [*]const char) *c_FILE;
  pub extern fn fseeko(stream: *c_FILE, offset: c_off_t, whence: c_int) c_int;
  pub extern fn ftello(stream: *c_FILE) c_off_t;
  pub extern fn setvbuf(stream: *c_FILE, buf: [*]char, mode: c_int, size: c_size_t) c_int;
  pub extern fn setbuf(stream: *c_FILE, buf: [*]char) void;
  pub extern fn getline(lineptr: **char, n: *c_size_t, stream: *c_FILE) c_ssize_t;
  pub extern fn popen(command: [*]const char, mode: [*]const char) *c_FILE;
  pub extern fn pclose(stream: *c_FILE) c_int;
}
