use std.string;

implement builtin char {
  pub fn is_ascii(self) bool {
    return @as(u32, self) < 128;
  }

  pub fn is_ascii_alphabetic(self) bool {
    return switch (self) {
      'A'..='Z' | 'a'..='z' => true,
      _ => false,
    };
  }

  pub fn is_ascii_digit(self) bool {
    let code = @as(u32, self);

    return code >= 48 && code <= 57;
  }

  pub fn is_ascii_alphanumeric(self) bool {
    return self.is_ascii_alphabetic() || self.is_ascii_digit();
  }

  pub fn is_ascii_whitespace(self) bool {
    return switch (@as(u32, self)) {
      32 | 9..=13 => true,
      _ => false,
    };
  }

  pub fn is_ascii_uppercase(self) bool {
    let code = @as(u32, self);

    return code >= 65 && code <= 90;
  }

  pub fn is_ascii_lowercase(self) bool {
    let code = @as(u32, self);

    return code >= 97 && code <= 122;
  }

  pub fn is_ascii_punctuation(self) bool {
    return switch (@as(u32, self)) {
      33..=126 => !self.is_ascii_alphanumeric(),
      _ => false,
    };
  }

  pub fn is_ascii_control(self) bool {
    let code = @as(u32, self);

    return code < 32 || code == 127;
  }

  pub fn is_ascii_graphic(self) bool {
    let code = @as(u32, self);

    return code > 32 && code < 127;
  }

  pub fn is_ascii_hexdigit(self) bool {
    return switch (self) {
      '0'..='9' | 'a'..='f' | 'A'..='F' => true,
      _ => false,
    };
  }

  pub fn is_alphabetic(self) bool {
    return self.is_ascii_alphabetic();
  }

  pub fn is_numeric(self) bool {
    return self.is_ascii_digit();
  }

  pub fn is_alphanumeric(self) bool {
    return self.is_ascii_alphanumeric();
  }

  pub fn is_whitespace(self) bool {
    return self.is_ascii_whitespace();
  }

  pub fn is_control(self) bool {
    return self.is_ascii_control();
  }

  pub fn is_uppercase(self) bool {
    return self.is_ascii_uppercase();
  }

  pub fn is_lowercase(self) bool {
    return self.is_ascii_lowercase();
  }

  pub fn to_ascii_uppercase(self) char {
    if (self.is_ascii_lowercase()) {
      return @as(char, @as(u32, self) - 32);
    };

    return self;
  }

  pub fn to_ascii_lowercase(self) char {
    if (self.is_ascii_uppercase()) {
      return @as(char, @as(u32, self) + 32);
    };

    return self;
  }

  pub fn eq_ignore_ascii_case(self, other: char) bool {
    return self.to_ascii_lowercase() == other.to_ascii_lowercase();
  }

  pub fn to_digit(self, radix: u32) Option[u32] {
    let value = switch (self) {
      '0'..='9' => @as(u32, self) - 48,
      'a'..='z' => @as(u32, self) - 97 + 10,
      'A'..='Z' => @as(u32, self) - 65 + 10,
      _ => { return Option.None; },
    };

    if (value >= radix) { return Option.None; };

    return Option.Some(value);
  }

  pub fn from_digit(num: u32, radix: u32) Option[char] {
    if (num >= radix) { return Option.None; };
    if (num < 10) { return Option.Some(@as(char, num + 48)); };

    return Option.Some(@as(char, num - 10 + 97));
  }

  pub fn from_u32(value: u32) Option[char] {
    return switch (value) {
      0..=0xD7FF | 0xE000..=0x10FFFF => Option.Some(@as(char, value)),
      _ => Option.None,
    };
  }

  pub fn len_utf8(self) u32 {
    return switch (@as(u32, self)) {
      0..=0x7F => 1,
      0x80..=0x7FF => 2,
      0x800..=0xFFFF => 3,
      _ => 4,
    };
  }

  pub fn len_utf16(self) u32 {
    return switch (@as(u32, self)) {
      0..=0xFFFF => 1,
      _ => 2,
    };
  }

  pub fn to_string(self) String {
    return @format("{}", self);
  }
}
