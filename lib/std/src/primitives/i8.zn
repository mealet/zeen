use std.primitives;
use std.string;

implement builtin i8 {
  pub fn bits() u32 {
    return @as(u32, 8 * @sizeof(i8));
  }

  pub fn min_value() i8 {
    let max = i8.max_value();
    return 0 - max - 1;
  }

  pub fn max_value() i8 {
    return @as(i8, @as(u8, ~@as(u8, 0)) >> 1);
  }

  pub fn count_ones(self) u32 {
    let v = @as(u8, self);
    let count: u32 = 0;
    while (v != 0) {
      v = v & (v - 1);
      count += 1;
    };
    return count;
  }

  pub fn count_zeros(self) u32 {
    return i8.bits() - self.count_ones();
  }

  pub fn leading_zeros(self) u32 {
    let v = @as(u8, self);
    if (v == 0) { return i8.bits(); };
    let mask: u8 = @as(u8, 1) << @as(u8, i8.bits() - 1);
    let count: u32 = 0;
    while ((v & mask) == 0) {
      count += 1;
      mask = mask >> 1;
    };
    return count;
  }

  pub fn trailing_zeros(self) u32 {
    let v = @as(u8, self);
    if (v == 0) { return i8.bits(); };
    let count: u32 = 0;
    while ((v & 1) == 0) {
      count += 1;
      v = v >> 1;
    };
    return count;
  }

  pub fn leading_ones(self) u32 {
    let inverted = ~self;
    return inverted.leading_zeros();
  }

  pub fn trailing_ones(self) u32 {
    let inverted = ~self;
    return inverted.trailing_zeros();
  }

  pub fn rotate_left(self, n: u32) i8 {
    let bits = i8.bits();
    let shift = n % bits;
    if (shift == 0) { return self; };
    let v = @as(u8, self);
    return @as(i8, (v << @as(u8, shift)) | (v >> @as(u8, bits - shift)));
  }

  pub fn rotate_right(self, n: u32) i8 {
    let bits = i8.bits();
    let shift = n % bits;
    if (shift == 0) { return self; };
    let v = @as(u8, self);
    return @as(i8, (v >> @as(u8, shift)) | (v << @as(u8, bits - shift)));
  }

  pub fn swap_bytes(self) i8 {
    return self;
  }

  pub fn reverse_bits(self) i8 {
    let v = @as(u8, self);
    let out: u8 = 0;
    let i: u32 = 0;
    while (i < i8.bits()) {
      out = (out << 1) | (v & 1);
      v = v >> 1;
      i += 1;
    };
    return @as(i8, out);
  }

  pub fn checked_add(self, rhs: i8) Option[i8] {
    if (rhs > 0 && self > i8.max_value() - rhs) { return Option.None; };
    if (rhs < 0 && self < i8.min_value() - rhs) { return Option.None; };
    return Option.Some(self + rhs);
  }

  pub fn checked_sub(self, rhs: i8) Option[i8] {
    if (rhs > 0 && self < i8.min_value() + rhs) { return Option.None; };
    if (rhs < 0 && self > i8.max_value() + rhs) { return Option.None; };
    return Option.Some(self - rhs);
  }

  pub fn checked_mul(self, rhs: i8) Option[i8] {
    if (self == 0 || rhs == 0) { return Option.Some(@as(i8, 0)); };
    if (self == -1 && rhs == i8.min_value()) { return Option.None; };
    if (rhs == -1 && self == i8.min_value()) { return Option.None; };
    let product = self * rhs;
    if (product / rhs != self) { return Option.None; };
    return Option.Some(product);
  }

  pub fn checked_div(self, rhs: i8) Option[i8] {
    if (rhs == 0) { return Option.None; };
    if (self == i8.min_value() && rhs == -1) { return Option.None; };
    return Option.Some(self / rhs);
  }

  pub fn checked_rem(self, rhs: i8) Option[i8] {
    if (rhs == 0) { return Option.None; };
    if (self == i8.min_value() && rhs == -1) { return Option.None; };
    return Option.Some(self % rhs);
  }

  pub fn checked_neg(self) Option[i8] {
    if (self == i8.min_value()) { return Option.None; };
    return Option.Some(0 - self);
  }

  pub fn checked_abs(self) Option[i8] {
    if (self == i8.min_value()) { return Option.None; };
    if (self < 0) { return Option.Some(0 - self); };
    return Option.Some(self);
  }

  pub fn checked_pow(self, exp: u32) Option[i8] {
    let result: i8 = 1;
    let base = self;
    let e = exp;
    while (e > 0) {
      if ((e & 1) == 1) {
        let next = result.checked_mul(base);
        if (next.is_none()) { return Option.None; };
        result = next.unwrap();
      };
      e = e >> 1;
      if (e > 0) {
        let squared = base.checked_mul(base);
        if (squared.is_none()) { return Option.None; };
        base = squared.unwrap();
      };
    };
    return Option.Some(result);
  }

  pub fn checked_shl(self, rhs: u32) Option[i8] {
    if (rhs >= i8.bits()) { return Option.None; };
    return Option.Some(self << @as(i8, rhs));
  }

  pub fn checked_shr(self, rhs: u32) Option[i8] {
    if (rhs >= i8.bits()) { return Option.None; };
    return Option.Some(self >> @as(i8, rhs));
  }

  pub fn wrapping_add(self, rhs: i8) i8 {
    return self + rhs;
  }

  pub fn wrapping_sub(self, rhs: i8) i8 {
    return self - rhs;
  }

  pub fn wrapping_mul(self, rhs: i8) i8 {
    return self * rhs;
  }

  pub fn wrapping_div(self, rhs: i8) i8 {
    return self / rhs;
  }

  pub fn wrapping_rem(self, rhs: i8) i8 {
    return self % rhs;
  }

  pub fn wrapping_pow(self, exp: u32) i8 {
    let result: i8 = 1;
    let base = self;
    let e = exp;
    while (e > 0) {
      if ((e & 1) == 1) { result = result * base; };
      e = e >> 1;
      if (e > 0) { base = base * base; };
    };
    return result;
  }

  pub fn wrapping_shl(self, rhs: u32) i8 {
    let shift = rhs % i8.bits();
    return self << @as(i8, shift);
  }

  pub fn wrapping_shr(self, rhs: u32) i8 {
    let shift = rhs % i8.bits();
    return self >> @as(i8, shift);
  }

  pub fn wrapping_neg(self) i8 {
    return 0 - self;
  }

  pub fn wrapping_abs(self) i8 {
    if (self < 0) { return 0 - self; };
    return self;
  }

  pub fn overflowing_add(self, rhs: i8) Overflowing[i8] {
    let sum = self + rhs;
    let overflowed = (rhs > 0 && sum < self) || (rhs < 0 && sum > self);
    return Overflowing { .value = sum, .overflowed = overflowed };
  }

  pub fn overflowing_sub(self, rhs: i8) Overflowing[i8] {
    let difference = self - rhs;
    let overflowed = (rhs > 0 && difference > self) || (rhs < 0 && difference < self);
    return Overflowing { .value = difference, .overflowed = overflowed };
  }

  pub fn overflowing_mul(self, rhs: i8) Overflowing[i8] {
    let product = self * rhs;
    let overflowed = if (self == 0 || rhs == 0) {
      false
    } else if (rhs == -1) {
      self == i8.min_value()
    } else {
      product / rhs != self
    };
    return Overflowing { .value = product, .overflowed = overflowed };
  }

  pub fn overflowing_neg(self) Overflowing[i8] {
    let value = 0 - self;
    return Overflowing { .value = value, .overflowed = self == i8.min_value() };
  }

  pub fn overflowing_abs(self) Overflowing[i8] {
    let value = if (self < 0) { 0 - self } else { self };
    return Overflowing { .value = value, .overflowed = self == i8.min_value() };
  }

  pub fn overflowing_pow(self, exp: u32) Overflowing[i8] {
    let result: i8 = 1;
    let base = self;
    let e = exp;
    let overflowed = false;
    while (e > 0) {
      if ((e & 1) == 1) {
        let next = result.overflowing_mul(base);
        result = next.value;
        overflowed = overflowed || next.overflowed;
      };
      e = e >> 1;
      if (e > 0) {
        let squared = base.overflowing_mul(base);
        base = squared.value;
        overflowed = overflowed || squared.overflowed;
      };
    };
    return Overflowing { .value = result, .overflowed = overflowed };
  }

  pub fn overflowing_shl(self, rhs: u32) Overflowing[i8] {
    let shift = rhs % i8.bits();
    let value = self << @as(i8, shift);
    return Overflowing { .value = value, .overflowed = rhs >= i8.bits() };
  }

  pub fn overflowing_shr(self, rhs: u32) Overflowing[i8] {
    let shift = rhs % i8.bits();
    let value = self >> @as(i8, shift);
    return Overflowing { .value = value, .overflowed = rhs >= i8.bits() };
  }

  pub fn saturating_add(self, rhs: i8) i8 {
    let sum = self.checked_add(rhs);
    if (sum.is_some()) { return sum.unwrap(); };
    if (rhs > 0) { return i8.max_value(); };
    return i8.min_value();
  }

  pub fn saturating_sub(self, rhs: i8) i8 {
    let difference = self.checked_sub(rhs);
    if (difference.is_some()) { return difference.unwrap(); };
    if (rhs > 0) { return i8.min_value(); };
    return i8.max_value();
  }

  pub fn saturating_mul(self, rhs: i8) i8 {
    let product = self.checked_mul(rhs);
    if (product.is_some()) { return product.unwrap(); };
    if ((self > 0) == (rhs > 0)) { return i8.max_value(); };
    return i8.min_value();
  }

  pub fn saturating_div(self, rhs: i8) i8 {
    return self / rhs;
  }

  pub fn saturating_neg(self) i8 {
    if (self == i8.min_value()) { return i8.max_value(); };
    return 0 - self;
  }

  pub fn saturating_abs(self) i8 {
    if (self == i8.min_value()) { return i8.max_value(); };
    if (self < 0) { return 0 - self; };
    return self;
  }

  pub fn saturating_pow(self, exp: u32) i8 {
    let powered = self.checked_pow(exp);
    if (powered.is_some()) { return powered.unwrap(); };
    if ((exp & 1) == 1 && self < 0) { return i8.min_value(); };
    return i8.max_value();
  }

  pub fn pow(self, exp: u32) i8 {
    return self.wrapping_pow(exp);
  }

  pub fn div_euclid(self, rhs: i8) i8 {
    let quotient = self / rhs;
    let remainder = self % rhs;
    if (remainder < 0) {
      if (rhs > 0) { return quotient - 1; };
      return quotient + 1;
    };
    return quotient;
  }

  pub fn rem_euclid(self, rhs: i8) i8 {
    let remainder = self % rhs;
    if (remainder < 0) {
      if (rhs > 0) { return remainder + rhs; };
      return remainder - rhs;
    };
    return remainder;
  }

  pub fn checked_div_euclid(self, rhs: i8) Option[i8] {
    let quotient = self.checked_div(rhs);
    if (quotient.is_none()) { return Option.None; };
    let remainder = self % rhs;
    if (remainder < 0) {
      if (rhs > 0) { return Option.Some(quotient.unwrap() - 1); };
      return Option.Some(quotient.unwrap() + 1);
    };
    return quotient;
  }

  pub fn checked_rem_euclid(self, rhs: i8) Option[i8] {
    let remainder = self.checked_rem(rhs);
    if (remainder.is_none()) { return Option.None; };
    if (remainder.unwrap() < 0) {
      if (rhs > 0) { return Option.Some(remainder.unwrap() + rhs); };
      return Option.Some(remainder.unwrap() - rhs);
    };
    return remainder;
  }

  pub fn div_ceil(self, rhs: i8) i8 {
    let quotient = self / rhs;
    let remainder = self % rhs;
    if ((remainder > 0 && rhs > 0) || (remainder < 0 && rhs < 0)) { return quotient + 1; };
    return quotient;
  }

  pub fn next_multiple_of(self, rhs: i8) i8 {
    let remainder = self % rhs;
    if (remainder == 0) { return self; };
    if ((remainder > 0) == (rhs > 0)) { return self + (rhs - remainder); };
    return self - remainder;
  }

  pub fn checked_next_multiple_of(self, rhs: i8) Option[i8] {
    let remainder = self % rhs;
    if (remainder == 0) { return Option.Some(self); };
    if ((remainder > 0) == (rhs > 0)) { return self.checked_add(rhs - remainder); };
    return self.checked_sub(remainder);
  }

  pub fn abs_diff(self, other: i8) u8 {
    if (self > other) { return @as(u8, self) - @as(u8, other); };
    return @as(u8, other) - @as(u8, self);
  }

  pub fn midpoint(self, other: i8) i8 {
    let sign: u8 = @as(u8, 1) << @as(u8, i8.bits() - 1);
    let a = @as(u8, self) ^ sign;
    let b = @as(u8, other) ^ sign;
    let middle = (a & b) + ((a ^ b) >> 1);
    return @as(i8, middle ^ sign);
  }

  pub fn min(self, other: i8) i8 {
    if (self < other) { return self; };
    return other;
  }

  pub fn max(self, other: i8) i8 {
    if (self > other) { return self; };
    return other;
  }

  pub fn clamp(self, min: i8, max: i8) i8 {
    if (self < min) { return min; };
    if (self > max) { return max; };
    return self;
  }

  pub fn abs(self) i8 {
    if (self < 0) { return 0 - self; };
    return self;
  }

  pub fn unsigned_abs(self) u8 {
    if (self < 0) { return @as(u8, 0) - @as(u8, self); };
    return @as(u8, self);
  }

  pub fn signum(self) i8 {
    if (self > 0) { return 1; };
    if (self < 0) { return -1; };
    return 0;
  }

  pub fn is_positive(self) bool {
    return self > 0;
  }

  pub fn is_negative(self) bool {
    return self < 0;
  }

  pub fn ilog2(self) u32 {
    if (self <= 0) { @panic("ilog2: argument must be positive"); };
    let value = @as(u8, self);
    return i8.bits() - 1 - value.leading_zeros();
  }

  pub fn ilog10(self) u32 {
    if (self <= 0) { @panic("ilog10: argument must be positive"); };
    let value = @as(u64, self);
    let count: u32 = 0;
    while (value >= 10) {
      value = value / 10;
      count += 1;
    };
    return count;
  }

  pub fn ilog(self, base: u32) u32 {
    if (self <= 0) { @panic("ilog: argument must be positive"); };
    if (base < 2) { @panic("ilog: base must be at least 2"); };
    let value = @as(u64, self);
    let step = @as(u64, base);
    let count: u32 = 0;
    while (value >= step) {
      value = value / step;
      count += 1;
    };
    return count;
  }

  pub fn to_be(self) i8 {
    return self.swap_bytes();
  }

  pub fn to_le(self) i8 {
    return self;
  }

  pub fn from_be(value: i8) i8 {
    return value.swap_bytes();
  }

  pub fn from_le(value: i8) i8 {
    return value;
  }

  pub fn to_be_bytes(self) [1]u8 {
    let v = @as(u8, self);
    let bytes: [1]u8 = [0; 1];
    let i: u32 = 0;
    while (i < 1) {
      bytes[@as(usize, i)] = @as(u8, v >> @as(u8, (1 - 1 - i) * 8));
      i += 1;
    };
    return bytes;
  }

  pub fn to_le_bytes(self) [1]u8 {
    let v = @as(u8, self);
    let bytes: [1]u8 = [0; 1];
    let i: u32 = 0;
    while (i < 1) {
      bytes[@as(usize, i)] = @as(u8, v >> @as(u8, i * 8));
      i += 1;
    };
    return bytes;
  }

  pub fn to_ne_bytes(self) [1]u8 {
    return self.to_le_bytes();
  }

  pub fn from_be_bytes(bytes: [1]u8) i8 {
    return @as(i8, bytes[0]);
  }

  pub fn from_le_bytes(bytes: [1]u8) i8 {
    let v: u8 = 0;
    let i: usize = 0;
    while (i < 1) {
      v = v | (@as(u8, bytes[i]) << @as(u8, i * 8));
      i += 1;
    };
    return @as(i8, v);
  }

  pub fn from_ne_bytes(bytes: [1]u8) i8 {
    return i8.from_le_bytes(bytes);
  }

  pub fn to_string(self) String {
    return @format("{}", self);
  }
}
