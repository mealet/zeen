// Standard library versioning is separated from compiler. It's form looks like:
/*
  v1.2.3
      │
      ▼
  ┌─┐┌─┐┌─┐
  │1││2││3│
  └┬┘└┬┘└┬┘
   └──┼──┼► Compiler's major version
      │  │
      └──┼► Compiler's minor version
         │
         └► Library's revision
 */

pub const STD_VERSION: []const char = "0.2.1";

pub const STD_VERSION_MAJOR: u8 = 0;
pub const STD_VERSION_MINOR: u8 = 2;
pub const STD_VERSION_REVISION: u8 = 1;
