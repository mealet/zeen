use std.c.stdlib;

/// Main standard library allocator
pub struct Allocator {
  pub fn alloc(size: usize) *void {
    let ptr = G_ALLOC(size);
    
    if (ptr == nullptr) {
      @panic("Null pointer appeared on std allocation");
    };
    
    ptr
  }

  pub fn realloc(ptr: *void, size: usize) *void {
    let ptr = G_REALLOC(ptr, size);

    if (ptr == nullptr) {
      @panic("Null pointer appeared on std allocation");
    };

    ptr
  }

  pub fn dealloc(ptr: *void) {
    if (ptr != nullptr)
      G_FREE(ptr);
  }
}

let G_ALLOC: fn(usize) *void = malloc;
let G_REALLOC: fn(*void, usize) *void = realloc;
let G_FREE: fn(*void) void = free;
