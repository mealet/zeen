use std.c.types;

@os[linux | darwin | freebsd | android] {
  pub const STDIN_FILENO: c_int = 0;
  pub const STDOUT_FILENO: c_int = 1;
  pub const STDERR_FILENO: c_int = 2;

  pub extern fn read(fd: c_int, buf: *void, count: c_size_t) c_ssize_t;
  pub extern fn write(fd: c_int, buf: [*]const void, count: c_size_t) c_ssize_t;
  pub extern fn close(fd: c_int) c_int;

  pub extern fn getpid() c_pid_t;
  pub extern fn getppid() c_pid_t;
  pub extern fn getuid() c_uid_t;
  pub extern fn getgid() c_gid_t;

  pub extern fn fork() c_pid_t;

  pub extern fn sleep(seconds: c_uint) c_uint;
  pub extern fn usleep(useconds: c_useconds_t) c_int;
  pub extern fn alarm(seconds: c_uint) c_uint;

  pub extern fn access(path: [*]const char, amode: c_int) c_int;
  pub extern fn chdir(path: [*]const char) c_int;
  pub extern fn getcwd(buf: [*]char, size: c_size_t) [*]char;
  pub extern fn unlink(path: [*]const char) c_int;
  pub extern fn rmdir(path: [*]const char) c_int;

  pub extern fn fsync(fd: c_int) c_int;
  pub extern fn _exit(status: c_int) void;
}
