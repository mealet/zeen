use std.c.types;

// wait options (shared across POSIX targets).
pub const WNOHANG: c_int = 1;
pub const WUNTRACED: c_int = 2;

@os[linux | android] {
  pub const WSTOPPED: c_int = 2;
  pub const WCONTINUED: c_int = 8;
  pub const WNOWAIT: c_int = 0x01000000;
}

@os[freebsd] {
  pub const WSTOPPED: c_int = 2;
  pub const WCONTINUED: c_int = 4;
  pub const WNOWAIT: c_int = 8;
}

@os[darwin] {
  pub const WSTOPPED: c_int = 0x8;
  pub const WCONTINUED: c_int = 0x10;
  pub const WNOWAIT: c_int = 0x20;
}

// Status macros shared by glibc and the BSDs.
pub fn WIFEXITED(status: c_int) bool {
  return (status & 0x7f) == 0;
}

pub fn WEXITSTATUS(status: c_int) c_int {
  return (status >> 8) & 0xff;
}

pub fn WTERMSIG(status: c_int) c_int {
  return status & 0x7f;
}

pub fn WCOREDUMP(status: c_int) bool {
  return (status & 0x80) != 0;
}

// glibc/musl/bionic: continuation status is 0xffff, stop mask is byte-wide.
@os[linux | android] {
  pub fn WIFSIGNALED(status: c_int) bool {
    return (status & 0x7f) != 0 && (status & 0x7f) != 0x7f;
  }

  pub fn WIFSTOPPED(status: c_int) bool {
    return (status & 0xff) == 0x7f;
  }

  pub fn WSTOPSIG(status: c_int) c_int {
    return (status >> 8) & 0xff;
  }

  pub fn WIFCONTINUED(status: c_int) bool {
    return status == 0xffff;
  }
}

@os[freebsd] {
  pub fn WIFSIGNALED(status: c_int) bool {
    return (status & 0x7f) != 0x7f && (status & 0x7f) != 0 && status != 0x13;
  }

  pub fn WIFSTOPPED(status: c_int) bool {
    return (status & 0x7f) == 0x7f;
  }

  pub fn WSTOPSIG(status: c_int) c_int {
    return status >> 8;
  }

  pub fn WIFCONTINUED(status: c_int) bool {
    return status == 0x13;
  }
}

@os[darwin] {
  pub fn WIFSIGNALED(status: c_int) bool {
    return (status & 0x7f) != 0x7f && (status & 0x7f) != 0;
  }

  pub fn WIFSTOPPED(status: c_int) bool {
    return (status & 0x7f) == 0x7f && (status >> 8) != 0x13;
  }

  pub fn WSTOPSIG(status: c_int) c_int {
    return status >> 8;
  }

  pub fn WIFCONTINUED(status: c_int) bool {
    return (status & 0x7f) == 0x7f && (status >> 8) == 0x13;
  }
}

// waitid needs siginfo_t (not bound yet); only wait/waitpid are provided.
@os[linux | android | darwin | freebsd] {
  pub extern fn wait(status: *c_int) c_pid_t;
  pub extern fn waitpid(pid: c_pid_t, status: *c_int, options: c_int) c_pid_t;
}