use std.c.types;

// Character limits
pub const CHAR_BIT: c_int = 8;
pub const MB_LEN_MAX: c_int = 16;

// char (signed on our targets)
pub const CHAR_MIN: i32 = -128;
pub const CHAR_MAX: i32 = 127;
pub const SCHAR_MIN: c_schar = -128;
pub const SCHAR_MAX: c_schar = 127;
pub const UCHAR_MAX: c_uchar = 255;

// short
pub const SHRT_MAX: c_short = 32767;
pub const SHRT_MIN: c_short = ~SHRT_MAX;
pub const USHRT_MAX: c_ushort = 65535;

// int
pub const INT_MAX: c_int = 2147483647;
pub const INT_MIN: c_int = ~INT_MAX;
pub const UINT_MAX: c_uint = 4294967295;

// long / long long
@os[windows] {
  pub const LONG_MAX: c_long = 2147483647;
  pub const LONG_MIN: c_long = ~LONG_MAX;
  pub const ULONG_MAX: c_ulong = ~0;
} else {
  @arch[i686 | wasm32] {
    pub const LONG_MAX: c_long = 2147483647;
    pub const LONG_MIN: c_long = ~LONG_MAX;
    pub const ULONG_MAX: c_ulong = ~0;
  } else {
    pub const LONG_MAX: c_long = 9223372036854775807;
    pub const LONG_MIN: c_long = ~LONG_MAX;
    pub const ULONG_MAX: c_ulong = ~0;
  }
}

pub const LLONG_MAX: c_longlong = 9223372036854775807;
pub const LLONG_MIN: c_longlong = ~LLONG_MAX;
pub const ULLONG_MAX: c_ulonglong = ~0;
