use std.c.types;

// `time_t`: `long` on POSIX (64-bit on LP64, 32-bit on i686 Linux/glibc),
// `__int64` on Windows (MSVC/mingw, even 32-bit), `long long` on wasi.  For
// each supported target this resolves to exactly one width.
@os[windows] {
  pub alias c_time_t = i64;
} else @family[wasm] {
  pub alias c_time_t = i64;
} else {
  pub alias c_time_t = c_long;
}

// `clock_t`: `long` on Windows (LLP64 -> 32-bit) and the other POSIX targets,
// `unsigned long` on macOS, `long long` on wasi.
@os[windows] {
  pub alias c_clock_t = c_long;
} else @os[darwin] {
  pub alias c_clock_t = c_ulong;
} else @family[wasm] {
  pub alias c_clock_t = i64;
} else {
  pub alias c_clock_t = c_long;
}

pub struct c_tm {
  pub tm_sec: c_int,
  pub tm_min: c_int,
  pub tm_hour: c_int,
  pub tm_mday: c_int,
  pub tm_mon: c_int,
  pub tm_year: c_int,
  pub tm_wday: c_int,
  pub tm_yday: c_int,
  pub tm_isdst: c_int
}

@os[windows] {
  pub const CLOCKS_PER_SEC: c_clock_t = 1000;
} else @os[darwin] {
  pub const CLOCKS_PER_SEC: c_clock_t = 100;
} else {
  pub const CLOCKS_PER_SEC: c_clock_t = 1000000;
}

// time queries
pub extern fn time(timer: *c_time_t) c_time_t;
pub extern fn clock() c_clock_t;
pub extern fn difftime(end: c_time_t, start: c_time_t) f64;
pub extern fn mktime(tm: *c_tm) c_time_t;

// conversion
pub extern fn gmtime(timer: *const c_time_t) *c_tm;
pub extern fn localtime(timer: *const c_time_t) *c_tm;
pub extern fn asctime(tm: *const c_tm) *char;
pub extern fn ctime(timer: *const c_time_t) *char;
pub extern fn strftime( buf: [*]char, max_size: c_size_t, fmt: [*]const char, tm: *const c_tm) c_size_t;
