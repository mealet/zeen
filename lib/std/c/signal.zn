use std.c.types;
use std.c.time;

pub alias c_sighandler_t = *void;

pub const SIG_DFL: c_sighandler_t = @as(*void, 0);
pub const SIG_IGN: c_sighandler_t = @as(*void, 1);

// Opaque sigset_t sized to the largest platform variant.
@os[linux] {
  pub struct c_sigset_t {
    pub __private: [16]u64,
  }
} else @os[android] {
  pub struct c_sigset_t {
    pub __private: [1]u64,
  }
} else @os[darwin] {
  pub alias c_sigset_t = c_uint;
} else @os[freebsd] {
  pub struct c_sigset_t {
    pub __private: [2]u64,
  }
} else {
  pub struct c_sigset_t {
    pub __private: [16]u64,
  }
}

// Opaque sigaction struct. The layout (field order and size) differs between
// platforms, so we expose only an opaque byte buffer sized to each platform's
// true struct size (glibc/musl b64: 152, android b64: 32, macOS: 16, FreeBSD:
// 32). Users who set fields must use the concrete structs in their own code.
@os[linux] {
  pub struct c_sigaction {
    pub __private: [152]u8,
  }
} else @os[android] {
  pub struct c_sigaction {
    pub __private: [32]u8,
  }
} else @os[darwin] {
  pub struct c_sigaction {
    pub __private: [16]u8,
  }
} else @os[freebsd] {
  pub struct c_sigaction {
    pub __private: [32]u8,
  }
} else {
  pub struct c_sigaction {
    pub __private: [152]u8,
  }
}

// ---------------------------------------------------------------------------
// Signal numbers - Windows
// ---------------------------------------------------------------------------
@os[windows] {
  pub const SIGINT: c_int = 2;
  pub const SIGILL: c_int = 4;
  pub const SIGABRT: c_int = 22;
  pub const SIGFPE: c_int = 8;
  pub const SIGSEGV: c_int = 11;
  pub const SIGTERM: c_int = 15;
}

// ---------------------------------------------------------------------------
// Signal numbers - POSIX (Linux)
// ---------------------------------------------------------------------------
@os[linux | android] {
  pub const SIGHUP: c_int = 1;
  pub const SIGINT: c_int = 2;
  pub const SIGQUIT: c_int = 3;
  pub const SIGILL: c_int = 4;
  pub const SIGTRAP: c_int = 5;
  pub const SIGABRT: c_int = 6;
  pub const SIGBUS: c_int = 7;
  pub const SIGFPE: c_int = 8;
  pub const SIGKILL: c_int = 9;
  pub const SIGUSR1: c_int = 10;
  pub const SIGSEGV: c_int = 11;
  pub const SIGUSR2: c_int = 12;
  pub const SIGPIPE: c_int = 13;
  pub const SIGALRM: c_int = 14;
  pub const SIGTERM: c_int = 15;
  pub const SIGSTKFLT: c_int = 16;
  pub const SIGCHLD: c_int = 17;
  pub const SIGCONT: c_int = 18;
  pub const SIGSTOP: c_int = 19;
  pub const SIGTSTP: c_int = 20;
  pub const SIGTTIN: c_int = 21;
  pub const SIGTTOU: c_int = 22;
  pub const SIGURG: c_int = 23;
  pub const SIGXCPU: c_int = 24;
  pub const SIGXFSZ: c_int = 25;
  pub const SIGVTALRM: c_int = 26;
  pub const SIGPROF: c_int = 27;
  pub const SIGWINCH: c_int = 28;
  pub const SIGIO: c_int = 29;
  pub const SIGPWR: c_int = 30;
  pub const SIGSYS: c_int = 31;
}

