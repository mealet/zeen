  pub const SIGHUP: c_int = 1;
  pub const SIGINT: c_int = 2;
  pub const SIGQUIT: c_int = 3;
  pub const SIGILL: c_int = 4;
  pub const SIGTRAP: c_int = 5;
  pub const SIGABRT: c_int = 6;
  pub const SIGEMT: c_int = 7;
  pub const SIGFPE: c_int = 8;
  pub const SIGKILL: c_int = 9;
  pub const SIGBUS: c_int = 10;
  pub const SIGSEGV: c_int = 11;
  pub const SIGSYS: c_int = 12;
  pub const SIGPIPE: c_int = 13;
  pub const SIGALRM: c_int = 14;
  pub const SIGTERM: c_int = 15;
  pub const SIGURG: c_int = 16;
  pub const SIGSTOP: c_int = 17;
  pub const SIGTSTP: c_int = 18;
  pub const SIGCONT: c_int = 19;
  pub const SIGCHLD: c_int = 20;
  pub const SIGTTIN: c_int = 21;
  pub const SIGTTOU: c_int = 22;
  pub const SIGIO: c_int = 23;
  pub const SIGXCPU: c_int = 24;
  pub const SIGXFSZ: c_int = 25;
  pub const SIGVTALRM: c_int = 26;
  pub const SIGPROF: c_int = 27;
  pub const SIGWINCH: c_int = 28;
  pub const SIGINFO: c_int = 29;
  pub const SIGUSR1: c_int = 30;
  pub const SIGUSR2: c_int = 31;
}

// ---------------------------------------------------------------------------
// SA_* flags
// ---------------------------------------------------------------------------
@os[linux | android] {
  pub const SA_NOCLDSTOP: c_int = 0x00000001;
  pub const SA_NOCLDWAIT: c_int = 0x00000002;
  pub const SA_SIGINFO: c_int = 0x00000004;
  pub const SA_ONSTACK: c_int = 0x08000000;
  pub const SA_RESTART: c_int = 0x10000000;
  pub const SA_NODEFER: c_int = 0x40000000;
  pub const SA_RESETHAND: c_int = 0x80000000;
} else @os[darwin | freebsd] {
  pub const SA_ONSTACK: c_int = 0x0001;
  pub const SA_RESTART: c_int = 0x0002;
  pub const SA_RESETHAND: c_int = 0x0004;
  pub const SA_NOCLDSTOP: c_int = 0x0008;
  pub const SA_NODEFER: c_int = 0x0010;
  pub const SA_NOCLDWAIT: c_int = 0x0020;
  pub const SA_SIGINFO: c_int = 0x0040;
}

// ---------------------------------------------------------------------------
// sigprocmask `how` constants
// ---------------------------------------------------------------------------
@os[linux | android] {
  pub const SIG_BLOCK: c_int = 0;
  pub const SIG_UNBLOCK: c_int = 1;
  pub const SIG_SETMASK: c_int = 2;
} else @os[darwin | freebsd] {
  pub const SIG_BLOCK: c_int = 1;
  pub const SIG_UNBLOCK: c_int = 2;
  pub const SIG_SETMASK: c_int = 3;
}

// ---------------------------------------------------------------------------
// Signal set manipulation (all POSIX targets).
// ---------------------------------------------------------------------------
@os[linux | android | darwin | freebsd] {
  pub extern fn sigemptyset(set: *c_sigset_t) c_int;
  pub extern fn sigfillset(set: *c_sigset_t) c_int;
  pub extern fn sigaddset(set: *c_sigset_t, signum: c_int) c_int;
  pub extern fn sigdelset(set: *c_sigset_t, signum: c_int) c_int;
  pub extern fn sigismember(set: *const c_sigset_t, signum: c_int) c_int;

  pub extern fn sigprocmask(how: c_int, set: *const c_sigset_t, oldset: *c_sigset_t) c_int;
  pub extern fn sigaction(signum: c_int, act: *const c_sigaction, oldact: *c_sigaction) c_int;
  pub extern fn sigpending(set: *c_sigset_t) c_int;
  pub extern fn sigsuspend(mask: *const c_sigset_t) c_int;

  pub extern fn kill(pid: c_pid_t, sig: c_int) c_int;
  pub extern fn raise(sig: c_int) c_int;

  pub extern fn signal(sig: c_int, handler: c_sighandler_t) c_sighandler_t;
}

// ---------------------------------------------------------------------------
// Timed/wait-based signal functions (Linux, bionic, FreeBSD; absent macOS).
// ---------------------------------------------------------------------------
@os[linux | android | freebsd] {
  pub extern fn sigtimedwait(set: *const c_sigset_t, info: *void, timeout: *const c_Timespec) c_int;
  pub extern fn sigwait(set: *const c_sigset_t, sig: *c_int) c_int;
}
