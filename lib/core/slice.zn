/// Ranges variations:
/// * `lo..hi` - `{ start: Some, end: Some }`
/// * `lo..=hi` - `{ start: Some, end: Some + 1 }`
/// * `lo..` - `{ start: Some, end: None }`
/// * `..hi` - `{ start: None, end: Some }`
/// * `..=hi` - `{ start: None, end: Some + 1 }`
/// * `..` - `{ start: None, end: None }`
pub struct Range {
  pub start: Option[usize],
  pub end: Option[usize],

  pub fn first(*const self) Option[usize] {
    self.start
  }

  pub fn last(*const self) Option[usize] {
    self.end
  }
}

implement Copy : Range {}

implement Iterator : Range {
  pub fn next(*self) Option[usize] {
    let start = self.start.unwrap_or(0);
    let done = self.end.is_some() && start >= self.end.unwrap_or(0);

    if (!done) {
      self.start = Option.Some(start + 1);
      return Option.Some(start);
    };

    Option.None
  }
}

pub interface[T] Sliceable {
  pub fn slice(*self, range: Range) []T;
}
