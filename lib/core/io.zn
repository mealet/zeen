/// Writer that appends a utf8 string (`[]const char`) into an output buffer.
/// Used as the `out` sink by `Display`/`Debug` implementations.
pub interface StrWriter {
  pub fn write_str(*self, value: []const char) void;
  pub fn write_str_raw(*self, ptr: [*]const char, len: usize) void;
  pub fn write_str_single(*self, value: char) void;
}

/// Compiler-provided runtime: writes `len` bytes from `ptr` to stdout.
/// The body is synthesized by the compiler during code generation.
extern fn __zeen_stdout_write(ptr: [*]const char, len: usize) void;

/// Compiler-reserved output stream (stdout of the executable).
pub struct OutStream {}

implement Copy : OutStream {}

implement StrWriter : OutStream {
  pub fn write_str(*self, value: []const char) void {
    __zeen_stdout_write(value.ptr, value.len);
  }

  pub fn write_str_raw(*self, ptr: [*]const char, len: usize) void {
    __zeen_stdout_write(ptr, len);
  }

  pub fn write_str_single(*self, value: char) void {
    __zeen_stdout_write(@as([*]const char, &value), 1);
  }
}

/// Render a structure in format macros (print, println, panic, format).
/// The writer is generic - both `OutStream` and heap `String` work.
pub interface Display {
  pub fn display[T: StrWriter](*const self, out: T) void;
}

/// Render a structure in debug macros (dbg, "{:?}" specifier).
pub interface Debug {
  pub fn debug[T: StrWriter](*const self, out: T) void;
}
