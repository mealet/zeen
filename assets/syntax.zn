// Zeen Programming Language.
// -> this file is development syntax description, which is used to keep
// -> in mind right syntax and core ideas due compiler and libraries construction.

// Comments are separated to: line-comment (`//`) and block-comment (`/* */`)

/* ====@ Literals @==== */
/*
  Supported literals in Zeen:
  * Integer (decimal, binary, hexadecimal, octal)
  * Float
  * Char (single byte character)
  * ByteChar (single byte character with `u8` type)
  * Str (basic string, type is like in C - `*char`)
  * RawStr (raw string with `r#"` and `"#` as terminators)
*/

/* ====@ Types @==== */
/*
  Builtin compiler types:
  > Signed Integers
    * i8
    * i16
    * i32
    * i64
    * isize (platform specific)

  > Unsigned Integers
    * u8
    * u16
    * u32
    * u64
    * usize (platform specific)

  > Floats
    * f32
    * f64

  > Non-categorized
    * bool (1 byte, true/false)
    * char (1 byte, unsigned)
    * void

  Advanced Types:
    * `self` - self struct reference, used in methods.
    * `Self` - alias for current structure.

    * Named types (like structures, enums)
    * Generic Types (can be used with interfaces: `T: Add, Display`)

    * `const T` - constant types
    * `*T` - pointer type (can be combined: `const *T` / `*const T`)

    * `[N]T` - array type (N - comptime size, T - element type)
    * `[]T` - slice type (T - element type)

    * `fn ABCD( T, T, .. ) T` - fn type (can be used in vtables, or closures)
*/

/* ====@ Includes @==== */

/*
  Includes are the core moduling tool for Zeen.
  Concept is to include public exports from another module and use them with provided names.
*/

// Keyword to include: `use`

use module; // `module.zn`

/*
  You can include modules from different directories.
  Here's extra keywords for modules dirs managing:
  * `super` - go to the parent directory (".." analogue).
  * `root` - go to project root directory.
  * `std` - alias for specialized Zeen libraries on your computer.
*/

use std.collections.vector; // `STD_PATH/collections/vector.zn`
use root.module; // `PROJECT_ROOT/module.zn`
use super.module; // `../module.zn`

/* ====@ Externs @==== */

/*
  Zeen allows you to work with extern C content: functions, headers, linkages.
  To externally declare function use syntax: `extern fn FUNCTION_NAME( ARG_TYPE, ARG_TYPE, ... ) RETURN_TYPE`
*/

extern fn malloc(usize) *void;
extern fn free(*void);
extern fn printf(const *char, ...); // `...` is VA_ARGS marker

/*
  Extern functions can have statements block and named parameters, that means function can be exported:
*/

extern fn add(a: i32, b: i32) i32 {
  return a + b;
}

/*
  If you just want to include C header to your project, use:
*/

extern include "lib.h"; // that will automatically declare functions and structures from header

/*
  Also supported extern variables:
*/

extern let stdout: **char;

/* ====@ Functions @==== */
/*
  Functions can take params, return (or not return) values and use generic types with appliable interfaces.
  Visibility is changeable (with `pub` keyword).
*/

fn foo(a: i32, b: i32) i32 {
  return a + b;
}

pub fn add_print[T: Add + Display](a: T, b: T) {
  println!("result: {}", a + b);
}

/* ====@ Structures @==== */
/*
  Structures can have fields, generic types and methods.
  To implement extra interface - use `implement` keyword with special separated syntax.
  Visibility is changeable (with `pub` keyword).
*/

struct Foo {
  value: i32,

  pub fn new(value: i32) Self {
    return Self {
      .value = value
    };
  }
}

implement Foo : Display {
  fn display(self) *char {
    return format!("{}", self.value);
  }
}

struct Value[T: Add, R: Add] {
  a: T,
  b: R
}

/* ====@ Enums @==== */
/*
  Enums are C-like without any extra features, can be casted to any integer.
  Visibility is changeable (with `pub` keyword).
*/

/* ====@ Macros @==== */
/*
  Macros is Zeen are comptime features to level up user experience.
  Avaible macros:
  * `@as(T, expr) T` - casts expression to specified type.
  * `@sizeof(T) usize` - returns size of provided type.
  * `@alignof(T) usize` - returns align of provided type.

  * `@print("format string", ...) void` - formats string with values and prints it.
  * `@println("format string", ...) void` - formats string with values and prints it with new line.
  * `@format("format string", ...) *char` - formats string with values and puts it on stack.

  * `@panic("format string", ...) never` - panics (emergency program stop with stack trace) with formatted string.
  * `@unreachable() never` - tells compiler that this code is unreachable. If runtime reaches that piece - code panics.
  * `@dbg(expr) expr` - prints debug info about expression and returns it.
*/

/* ====@ Variables @==== */
// To define mutable variable with implicit type:
// -> let a = 123;
//
// To define non-mutable variable with implicit type:
// -> const a = 123;
//
// To define mutable variable with explicit type:
// -> let a: i32 = 123;
//
// To define non-mutable variable with explicit type:
// -> const a: i32 = 123;
//
// To define unintialized variable (requires explicit type):
// -> let a: i32;
//
// Constant definition without initialization is not allowed.


/* ====@ Generics Usage @==== */
/*
  Structs and functions can have generic types, there's 2 ways to use them:
*/

fn foo[T: Display](a: T) { /* ... */ }

fn main() {

  // 1. Implicit usage by argument.
  let a: i32 = 10;
  foo(a); // will represent foo[i32]()

  // 2. Explicit
  let a = 123;
  foo #[i64] (a);
}

/* ====@ Loops @==== */
/*
  While Loop:
  `while (condition) statement`
*/

fn main() {
  while (true)
    let a = 123;

  while (true) {
    let a = 123;
  }
}

/*
  For Loop:
  `for (varname : iterator) statement`
*/

fn main() {
  for (i : 10)
    println!("{}", i);

  for (i : 10) {
    println!("{}", i);
  }
}
