# Maintainer: mealet <workjason34@gmail.com>
pkgname=zeen
pkgver=0.3.0
pkgrel=1
pkgdesc="Compiler, language server and package manager of the Zeen language"
arch=('x86_64')
url="https://github.com/mealet/zeen"
license=('Apache-2.0')
depends=('gcc-libs' 'glibc' 'llvm-libs')
makedepends=('cargo' 'llvm')
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        "zora::git+https://github.com/mealet/zora")
sha256sums=('SKIP' 'SKIP')

prepare() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --manifest-path compiler/Cargo.toml
    cargo fetch --locked --manifest-path lsp/Cargo.toml
    cargo fetch --locked --manifest-path "$srcdir/zora/Cargo.toml"
}

build() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo build --frozen --release --manifest-path compiler/Cargo.toml -p zeen --features llvm-dynamic
    cargo build --frozen --release --manifest-path lsp/Cargo.toml
    cargo build --frozen --release --manifest-path "$srcdir/zora/Cargo.toml"
}

check() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export ZEEN_STD="$PWD/lib/std"
    cargo test --frozen --manifest-path compiler/Cargo.toml --workspace
    cargo test --frozen --manifest-path lsp/Cargo.toml
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 compiler/target/release/zeen "$pkgdir/usr/bin/zeen"
    install -Dm755 lsp/target/release/zeen-lsp "$pkgdir/usr/bin/zeen-lsp"
    install -Dm755 "$srcdir/zora/target/release/zora" "$pkgdir/usr/bin/zora"
    install -d "$pkgdir/usr/share/zeen"
    cp -r lib/std "$pkgdir/usr/share/zeen/std"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
