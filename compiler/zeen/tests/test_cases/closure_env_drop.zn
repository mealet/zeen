struct Tag {
    pub name: i32,
}

implement Drop : Tag {
    fn drop(self) {
        @println("drop {}", self.name);
    }
}

fn main() void {
    let a = Tag { .name = 1 };
    let f = fn() void {
        let x = a;
        @println("body ran");
    };
    f();
    @println("after f");

    let b = Tag { .name = 2 };
    let g = fn() void {
        let x = b;
        @println("g body");
    };
    @println("before end");
}