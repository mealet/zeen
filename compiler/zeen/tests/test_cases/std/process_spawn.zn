use std.string;
use std.process;

fn prog_echo() Command {
  @os[windows] {
    return Command.new("cmd").arg("/c").arg("echo");
  } else {
    return Command.new("echo");
  }
}

fn main() i32 {
  let out = prog_echo().arg("hello").output();
  if (out.is_err()) {
    @println("echo-err");
    return 1;
  };
  let captured = out.unwrap();
  @println("echo-ok={} code={}", captured.status.success(), captured.status.code().unwrap());
  @println("echo-text=[{}]", captured.stdout.trim_end());

  let mout = prog_echo().arg("a").arg("b").output().unwrap();
  @println("args=[{}]", mout.stdout.trim_end());

  @os[windows] {
    let st = Command.new("cmd").arg("/c").arg("exit").arg("1").status().unwrap();
    @println("fail-ok={} code={}", st.success(), st.code().unwrap());
  } else {
    let st = Command.new("false").status().unwrap();
    @println("fail-ok={} code={}", st.success(), st.code().unwrap());
  }

  @os[windows] {
    let sout = Command.new("cmd").arg("/c").arg("set").env("ZEEN_SPAWN_PROBE", "wibble").output().unwrap();
    @println("env-seen={}", sout.stdout.contains_str("ZEEN_SPAWN_PROBE=wibble"));
    let hout = Command.new("cmd")
      .arg("/c")
      .arg("set")
      .env("ZEEN_SPAWN_PROBE", "wibble")
      .env_remove("ZEEN_SPAWN_PROBE")
      .output()
      .unwrap();
    @println("env-hidden={}", !hout.stdout.contains_str("ZEEN_SPAWN_PROBE=wibble"));
  } else {
    let sout = Command.new("env").env("ZEEN_SPAWN_PROBE", "wibble").output().unwrap();
    @println("env-seen={}", sout.stdout.contains_str("ZEEN_SPAWN_PROBE=wibble"));
    let hout = Command.new("env")
      .env("ZEEN_SPAWN_PROBE", "wibble")
      .env_remove("ZEEN_SPAWN_PROBE")
      .output()
      .unwrap();
    @println("env-hidden={}", !hout.stdout.contains_str("ZEEN_SPAWN_PROBE=wibble"));
  }

  @os[windows] {
    let aout = Command.new("cmd").arg("/c").arg("cd").current_dir("C:\\").output().unwrap();
    @println("cwd=[{}]", aout.stdout.trim_end());
  } else {
    let aout = Command.new("pwd").current_dir("/").output().unwrap();
    @println("cwd=[{}]", aout.stdout.trim_end());
  }

  @os[windows] {
    let echo_in = Command.new("cmd").arg("/c").arg("sort").stdin(Stdio.Piped).stdout(Stdio.Piped);
    let spawned = echo_in.spawn().unwrap();
    {
      let writer = spawned.take_stdin().unwrap();
      if (writer.write_all("piped-in\n").is_err()) {
        @println("stdin-back=ERR");
        return 1;
      };
    };
    let reader = spawned.take_stdout().unwrap();
    let back = String.new();
    reader.read_to_string(&back).unwrap();
    spawned.wait().unwrap();
    @println("stdin-back=[{}]", back.trim_end());
  } else {
    let echo_in = Command.new("cat").stdin(Stdio.Piped).stdout(Stdio.Piped);
    let spawned = echo_in.spawn().unwrap();
    {
      let writer = spawned.take_stdin().unwrap();
      if (writer.write_all("piped-in\n").is_err()) {
        @println("stdin-back=ERR");
        return 1;
      };
    };
    let reader = spawned.take_stdout().unwrap();
    let back = String.new();
    reader.read_to_string(&back).unwrap();
    spawned.wait().unwrap();
    @println("stdin-back=[{}]", back.trim_end());
  }

  @os[windows] {
    @println("big-out=skip big-err=skip");
  } else {
    let bout = Command.new("sh").arg("-c").arg("seq 1 30000; seq 1 30000 >&2").output().unwrap();
    @println("big-out={} big-err={}", bout.stdout.len() > 100000, bout.stderr.len() > 100000);
  }

  @os[windows] {
    @println("kill-signal=skip");
  } else {
    let resting = Command.new("sleep").arg("30").spawn().unwrap();
    let polled = resting.try_wait().unwrap();
    @println("still-running={}", polled.is_none());
    resting.kill().unwrap();
    let done = resting.wait().unwrap();
    @println("kill-signal={}", done.signal().unwrap_or(0));
  }

  let missing = Command.new("zeen-no-such-program-xyz").status();
  @println("missing-err={}", missing.is_err());

  let reused = Command.new("echo").arg("again");
  let first = reused.output().unwrap();
  let second = reused.output().unwrap();
  @println(
    "reuse=[{}] [{}]",
    first.stdout.trim_end(),
    second.stdout.trim_end(),
  );
  return 0;
}
