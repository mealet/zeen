use std.c.posix.sys.mman;
use std.c.posix.unistd;
use std.c.posix.fcntl;

fn main() i32 {
  let fd: c_int = open("/tmp/zeen_mman_case", O_CREAT | O_WRONLY | O_TRUNC, 0o644);
  let buf: [*]const char = "hello";
  let _: c_ssize_t = write(fd, @as([*]const void, buf), 5);
  let _: c_int = close(fd);

  let rfd: c_int = open("/tmp/zeen_mman_case", O_RDONLY, 0);
  let size: usize = 4096;
  let addr = mmap(nullptr, size, PROT_READ, MAP_PRIVATE, rfd, 0);
  @println("map_ok={} len_ok={}", addr != MAP_FAILED, @as([*]const u8, addr)[4] == 111);
  let _: c_int = munmap(addr, size);
  let _: c_int = close(rfd);

  let _: c_int = unlink("/tmp/zeen_mman_case");
  return 0;
}