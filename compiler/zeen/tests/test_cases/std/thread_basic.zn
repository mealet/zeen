use std.thread;

fn main() i32 {
  let m = Arc.new(Mutex.new(0));
  let c1 = m.clone();
  let c2 = m.clone();

  let t1 = Thread.spawn(fn() i32 {
    let i: i32 = 0;
    while (i < 100) {
      let g = c1.get_mut().lock();
      *g += 1;
      i += 1;
    }
    return 1;
  });
  let t2 = Thread.spawn(fn() i32 {
    let i: i32 = 0;
    while (i < 100) {
      let g = c2.get_mut().lock();
      *g += 1;
      i += 1;
    }
    return 2;
  });

  let sum = t1.join() + t2.join();
  let total = *m.get_mut().lock();
  @println("sum={} total={}", sum, total);
  return 0;
}
