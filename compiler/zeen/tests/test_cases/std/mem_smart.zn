use std.alloc;
use std.mem;

struct Noisy {
  pub id: i32,
}

implement Drop : Noisy {
  fn drop(self) {
    @println("drop {}", self.id);
  }
}

fn main() {
  let u = Unique.new(42);
  @println("u={}", *u);
  *u = 100;
  @println("u={}", *u);

  u.reset(7);
  @println("reset={}", *u);

  let raw = u.release();
  @println("released={}", *raw);
  Allocator.dealloc(@as(*void, raw));

  let s = Shared.new(10);
  @println("count={}", s.use_count());
  @println("unique={}", s.is_unique());

  let t = s.clone();
  @println("count={}", s.use_count());
  @println("t={}", *t);
  *t = 20;
  @println("s={}", *s);
  @println("unique={}", s.is_unique());

  let maybe: Option[Unique[i32]] = Option.Some(Unique.new(5));
  switch (maybe) {
    .Some(v) => @println("maybe={}", *v),
    .None => @println("maybe=None"),
  };

  let none: Option[Unique[i32]] = Option.None;
  @println("has={}", none.is_some());

  let n = Unique.new(Noisy { .id = 1 });
  @println("noisy={}", n.get().id);
  n.reset(Noisy { .id = 2 });
  @println("noisy={}", n.get().id);

  let sh = Shared.new(Noisy { .id = 3 });
  {
    let sh2 = sh.clone();
    @println("shared count={}", sh.use_count());
    @println("id={}", sh2.get().id);
  };
  @println("shared count={}", sh.use_count());
}
