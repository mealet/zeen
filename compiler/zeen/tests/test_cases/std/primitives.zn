fn main() {
  let a: i32 = -5;
  @println("{}", a.abs());
  @println("{}", a.signum());
  @println("{}", a.is_negative());
  @println("{}", a.unsigned_abs());
  @println("{}", a.count_ones());
  @println("{}", a.count_zeros());
  @println("{}", a.leading_zeros());
  @println("{}", a.trailing_zeros());
  @println("{}", a.rotate_left(1));
  @println("{}", a.rotate_right(1));
  @println("{}", a.swap_bytes());
  @println("{}", a.reverse_bits());
  @println("{}", i32.bits());
  @println("{}", i32.min_value());
  @println("{}", i32.max_value());
  @println("{}", a.pow(3));
  @println("{}", a.div_euclid(3));
  @println("{}", a.rem_euclid(3));
  @println("{}", a.div_ceil(3));
  @println("{}", a.next_multiple_of(3));
  @println("{}", a.midpoint(10));
  @println("{}", a.min(3));
  @println("{}", a.max(3));
  @println("{}", a.clamp(-1, 1));
  @println("{}", a.abs_diff(7));
  let positive: i32 = 100;
  @println("{}", positive.ilog2());
  @println("{}", positive.ilog10());
  @println("{}", positive.ilog(2));

  let max: i32 = i32.max_value();
  @println("{}", max.checked_add(1).is_none());
  @println("{}", max.saturating_add(1));
  @println("{}", max.wrapping_add(1));
  @println("{}", max.overflowing_add(1).overflowed);
  @println("{}", max.overflowing_add(1).value);
  @println("{}", a.checked_abs().unwrap());
  @println("{}", a.checked_neg().unwrap());
  @println("{}", a.checked_pow(2).unwrap());
  @println("{}", a.checked_div(0).is_none());
  @println("{}", a.checked_shl(1).unwrap());

  @println("{}", i32.from_le_bytes(a.to_le_bytes()));
  @println("{}", i32.from_be_bytes(a.to_be_bytes()));
  @println("{}", a.to_le());

  let small: u8 = 200;
  @println("{}", small.count_ones());
  @println("{}", small.count_zeros());
  @println("{}", small.leading_zeros());
  @println("{}", small.is_power_of_two());
  @println("{}", small.next_power_of_two());
  @println("{}", small.checked_next_power_of_two().is_none());
  @println("{}", small.saturating_add(100));
  @println("{}", small.wrapping_add(100));
  @println("{}", small.overflowing_add(100).overflowed);
  @println("{}", u8.bits());
  @println("{}", u8.min_value());
  @println("{}", u8.max_value());

  let wide: u64 = 144;
  @println("{}", wide.isqrt());
  @println("{}", wide.ilog2());
  @println("{}", wide.ilog10());
  @println("{}", wide.div_ceil(10));
  @println("{}", wide.abs_diff(100));
  @println("{}", u64.max_value());
  @println("{}", u64.max_value().checked_add(1).is_none());

  let x: f64 = 2.25;
  @println("{}", x.sqrt());
  @println("{}", x.powf(2.0));
  @println("{}", x.powi(3));
  @println("{}", x.floor());
  @println("{}", x.ceil());
  @println("{}", x.round());
  @println("{}", x.trunc());
  @println("{}", x.fract());
  @println("{}", x.recip());
  @println("{}", x.abs());
  @println("{}", x.signum());
  @println("{}", x.hypot(4.0));
  @println("{}", x.min(3.0));
  @println("{}", x.max(3.0));
  @println("{}", x.clamp(0.0, 2.0));
  @println("{}", x.minimum(3.0));
  @println("{}", x.maximum(3.0));
  @println("{}", x.mul_add(2.0, 1.0));
  @println("{}", x.to_degrees());
  @println("{}", x.to_radians());
  @println("{}", x.div_euclid(2.0));
  @println("{}", x.rem_euclid(2.0));
  @println("{}", f64.from_bits(x.to_bits()));
  @println("{}", f64.nan().is_nan());
  @println("{}", f64.infinity().is_infinite());
  @println("{}", f64.epsilon());
  @println("{}", f64.min_positive_value());
  @println("{}", f64.max_value().is_finite());
  @println("{}", f64.neg_infinity().is_sign_negative());

  let c: char = 'z';
  @println("{}", c.is_ascii_lowercase());
  @println("{}", c.is_ascii_alphabetic());
  @println("{}", c.to_ascii_uppercase());
  @println("{}", c.eq_ignore_ascii_case('Z'));
  @println("{}", c.to_digit(36).unwrap());
  @println("{}", char.from_digit(10, 16).unwrap());
  @println("{}", char.from_u32(0x1F600).is_some());
  @println("{}", char.from_u32(0xD800).is_none());
  @println("{}", c.len_utf8());
  @println("{}", c.len_utf16());

  @println("{}", true.to_string());
  @println("{}", (-42).to_string());
  @println("{}", x.to_string());
}
