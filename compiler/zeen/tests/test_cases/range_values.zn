fn main() {
  // `0..n`: both bounds are present.
  let a = 0..3;
  @println("a {} {} {}", a.start.is_some(), a.start.unwrap_or(0), a.end.unwrap_or(0));

  // `..n`: no lower bound.
  let b = ..3;
  @println("b {} {} {}", b.start.is_some(), b.start.unwrap_or(0), b.end.unwrap_or(0));

  // `0..`: no upper bound.
  let c = 0..;
  @println("c {} {} {}", c.start.is_some(), c.start.unwrap_or(0), c.end.unwrap_or(0));

  // `..`: full range, neither bound.
  let d = ..;
  @println("d {} {} {}", d.start.is_some(), d.start.unwrap_or(0), d.end.unwrap_or(0));

  // Inclusive ranges store `end + 1`.
  let e = 0..=3;
  @println("e {} {}", e.end.is_some(), e.end.unwrap_or(0));

  // Accessor methods mirror the fields.
  @println("f {}{}", a.first().is_some(), a.last().is_some());

  // end is exclusive for a plain range
  let g = 2..2;
  @println("g {} {}", g.start.unwrap_or(0), g.end.unwrap_or(0));
}