interface Show {
  fn show(*const self) []const char;
}

implement Show : builtin i32 {
  fn show(*const self) []const char {
    return "i32";
  }
}

implement Show : builtin []i32 {
  fn show(*const self) []const char {
    return "i32 slice";
  }
}

implement[T] Show : builtin []T {
  fn show(*const self) []const char {
    return "generic slice";
  }
}

implement[T: Copy] Show : builtin []const T {
  fn show(*const self) []const char {
    return "const slice";
  }
}

implement Show : builtin [4]u8 {
  fn show(*const self) []const char {
    return "byte array";
  }
}

implement[T: Show] Show : builtin [*]T {
  fn show(*const self) []const char {
    return "many pointer";
  }
}

interface Countable {
  fn count(*const self) usize;
}

implement[T] builtin []T {
  fn count(*const self) usize {
    return (*self).len;
  }
}

implement[T] Countable : builtin []T {}

fn describe[T: Show](value: *const T) []const char {
  return value.show();
}

fn count_of[T: Countable](value: *const T) usize {
  return value.count();
}

fn main() {
  let nums: [4]i32 = [1, 2, 3, 4];
  let reals: [3]f64 = [1.5, 2.5, 3.5];
  let bytes: [4]u8 = [1, 2, 3, 4];

  @println("{}", nums[..].show());
  @println("{}", reals[..].show());
  @println("{}", bytes.show());

  let const_nums: []const i32 = nums[..];
  @println("{}", const_nums.show());

  let p: [*]i32 = @as([*]i32, &nums[0]);
  @println("{}", p.show());

  @println("{}", describe(&nums[..]));
  @println("{}", describe(&reals[..]));
  @println("{}", describe(&p));

  @println("{}", nums[..].count());
  @println("{}", count_of(&nums[..]));
  @println("{}", count_of(&reals[..]));
}
