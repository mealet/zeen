use std.string;

interface Fingerprint {
  fn hash(*const self) u64;
}

implement Fingerprint : builtin i32 {
  fn hash(*const self) u64 {
    return 7;
  }
}

implement Display : builtin i32 {
  fn display[W: StrWriter](*const self, out: *W) void {
    out.write_str("custom i32");
  }
}

implement Add : builtin i32 {
  fn add(self, other: i32) i32 {
    return 99;
  }
}

fn main() {
  let n: i32 = 123;
  @println("{}", n.hash());
  @println("{}", 123.hash() == 7);

  let u: u64 = 123;
  @println("{}", u.hash() == u.hash());

  let buffer = String.from("");
  n.display(&buffer);
  @println("{}", buffer);

  let a: i32 = 3;
  @println("{} {}", a.add(4), a + 4);

  @println("{}", n);
}
