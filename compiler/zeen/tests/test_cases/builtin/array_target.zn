implement builtin [4]u8 {
  fn total(*const self) u32 {
    return @as(u32, (*self)[0]) + @as(u32, (*self)[1]) + @as(u32, (*self)[2]) + @as(u32, (*self)[3]);
  }

  fn reversed(*const self) [4]u8 {
    return [(*self)[3], (*self)[2], (*self)[1], (*self)[0]];
  }
}

implement[T] builtin [4]T {
  fn size(*const self) usize {
    return 4;
  }
}

implement[T] builtin [*]T {
  fn head(*const self) T {
    return (*self)[0];
  }
}

fn main() {
  let bytes: [4]u8 = [1, 2, 3, 4];
  @println("{}", bytes.total());
  @println("{}", bytes.reversed()[0]);
  @println("{}", bytes.size());

  let nums: [4]i32 = [7, 8, 9, 10];
  @println("{}", nums.size());

  let ptr: [*]i32 = @as([*]i32, &nums[0]);
  @println("{}", ptr.head());
}
