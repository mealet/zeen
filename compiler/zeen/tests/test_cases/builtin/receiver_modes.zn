implement builtin i32 {
  fn by_value(self) i32 {
    return self + 1;
  }

  fn by_const_value(const self) i32 {
    return self + 2;
  }

  fn by_mut_ref(*self) i32 {
    *self += 3;
    return *self;
  }

  fn by_const_ref(*const self) i32 {
    return (*self) + 4;
  }
}

fn main() {
  let a: i32 = 10;
  @println("{}", a.by_value());
  @println("{}", a.by_const_value());
  @println("{}", a.by_mut_ref());
  @println("{}", a);

  let p: *i32 = &a;
  @println("{}", p.by_const_ref());
  @println("{}", p.by_mut_ref());
  @println("{}", p.by_const_ref());

  let cp: *const i32 = &a;
  @println("{}", cp.by_const_ref());
  @println("{}", a.by_const_ref());
}
