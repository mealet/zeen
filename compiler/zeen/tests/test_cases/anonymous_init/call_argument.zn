struct Point {
  pub x: i32,
  pub y: i32,
}

fn sum(first: Point, second: Point) i32 {
  return first.x + first.y + second.x + second.y;
}

fn main() {
  let value = sum(.{ .x = 1, .y = 2 }, .{ .x = 3, .y = 4 });
  let named = sum(Point { .x = 5, .y = 6 }, .{ .x = 7, .y = 8 });

  @println("{} {}", value, named);
}
