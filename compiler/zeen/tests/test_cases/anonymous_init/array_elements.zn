struct Point {
  pub x: i32,
  pub y: i32,
}

fn main() {
  let points: [3]Point = { .{ .x = 1, .y = 1 }, .{ .x = 2, .y = 2 }, .{ .x = 3, .y = 3 } };
  let repeated: [4]Point = { .{ .x = 4, .y = 5 }; 4 };

  @println("{} {} {}", points[0].x, points[2].y, repeated[3].x);
  @println("{}", repeated[1].y);
}
