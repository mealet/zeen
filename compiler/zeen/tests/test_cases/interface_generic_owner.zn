interface Sizing {
  pub fn size(*const self) usize;
}

struct Wrap[T] {
  value: T,
}

implement[T] Sizing : Wrap[T] {
  pub fn size(*const self) usize {
    return @sizeof(T);
  }
}

implement[T] builtin []T {
  pub fn size(*const self) usize {
    return (*self).len;
  }
}

implement[T] Sizing : builtin []T {}

fn measure[T: Sizing](value: *const T) usize {
  return value.size();
}

fn main() {
  let a: Wrap[i32] = Wrap { .value = 1 };
  let b: Wrap[f64] = Wrap { .value = 1.0 };
  let nums: [4]i32 = {1, 2, 3, 4};

  @println("{} {} {} {}", a.size(), measure(&a), b.size(), measure(&b));
  @println("{} {}", nums[..].size(), measure(&nums[..]));
}
