fn returner[T: Copy](v: T) Fn(T) T {
    return fn(x: T) T { return x; };
}

fn make_fn[T: Copy](v: T) Fn() T {
    return fn() T { return v; };
}

fn main() i32 {
    let a = returner#[i32](1)(10);
    let b = returner#[f64](2.5)(10.5);
    let c = make_fn(7);
    let d = make_fn(0.25);

    @println("a={}", a);
    @println("b={}", b);
    @println("c={}", c());
    @println("d={}", d());
    return 0;
}
