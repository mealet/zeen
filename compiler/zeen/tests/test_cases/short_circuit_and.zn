let hits: i32 = 0;

fn poke(v: bool) bool {
  hits = hits + 1;
  return v;
}

fn main() i32 {
  let p: *i32 = nullptr;
  if (p != nullptr && *p == 1) {
    @println("bad");
  } else {
    @println("guard-ok");
  };

  let a = poke(false) && poke(true);
  let b = poke(true) && poke(true);
  let c = poke(true) && poke(false) && poke(true);
  @println("{} {} {} {}", a, b, c, hits);
  return 0;
}
