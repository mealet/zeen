fn find_pair(target: i32) i32 {
  let found: i32 = -1;

  outer: for (row : 0..3) {
    for (col : 0..3) {
      if (@as(i32, row * 3 + col) == target) {
        found = @as(i32, row * 10 + col);
        break :outer;
      }
    }
  }

  return found;
}

fn skip_rows() i32 {
  let total: i32 = 0;

  rows: for (row : 0..3) {
    for (col : 0..3) {
      if (col == 1) {
        continue :rows;
      }

      total += 1;
    }
  }

  return total;
}

fn scan_limit() i32 {
  let outer: i32 = 0;
  let steps: i32 = 0;

  scan: while (outer < 4) : (outer += 1) {
    let inner: i32 = 0;

    while (inner < 4) : (inner += 1) {
      steps += 1;

      if (outer == 2 && inner == 1) {
        break :scan;
      }
    }
  }

  return steps;
}

fn continue_update() i32 {
  let outer: i32 = 0;
  let hits: i32 = 0;

  outer_loop: while (outer < 3) : (outer += 1) {
    let inner: i32 = 0;

    while (inner < 3) : (inner += 1) {
      if (inner == 1) {
        continue :outer_loop;
      }

      hits += 1;
    }
  }

  return hits;
}

fn else_behavior() i32 {
  let natural: i32 = 0;

  outer: for (row : 0..3) {
    for (col : 0..3) {
      if (col == 1) {
        break :outer;
      }
    }
  } else {
    natural += 100;
  }

  for (i : 0..2) {
    natural += 1;
  } else {
    natural += 10;
  }

  return natural;
}

fn plain() i32 {
  let total: i32 = 0;

  for (i : 0..5) {
    if (i == 3) {
      break;
    }

    if (i == 1) {
      continue;
    }

    total += 1;
  }

  return total;
}

fn main() {
  @println("{}", find_pair(4));
  @println("{}", find_pair(8));
  @println("{}", find_pair(20));
  @println("{}", skip_rows());
  @println("{}", scan_limit());
  @println("{}", continue_update());
  @println("{}", else_behavior());
  @println("{}", plain());
}
