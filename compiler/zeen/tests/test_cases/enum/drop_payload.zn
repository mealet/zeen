struct Handle {
  pub h: i32,
}

implement Drop : Handle {
  fn drop(self) void {
    @println("drop {}", self.h);
  }
}

enum Resource {
  none,
  owned: Handle,
  pair: {
    first: Handle,
    second: i32,
  },
}

fn main() {
  {
    let a = Resource.owned(Handle { .h = 1 });
  };
  {
    let b = Resource.pair { .first = Handle { .h = 2 }, .second = 9 };
  };
  @println("done");
}
