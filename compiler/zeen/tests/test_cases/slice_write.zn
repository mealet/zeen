fn first[T](s: []T) T {
  return s[0];
}

fn main() {
  let a = [1, 2, 3, 4, 5];

  a[1..3][0] = 99;
  @println("range-write {}", a[1]);

  let s = a[..];
  s[4] = 7;
  @println("local-write {}", s[4]);

  a[2..][0] = a[3..][0] + 1;
  @println("shift {}", a[2]);

  let sc: []const i32 = [8, 9, 10][..];
  @println("const-generic {}", first(sc[1..]));
}
