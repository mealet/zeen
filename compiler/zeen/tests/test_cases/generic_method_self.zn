struct Pair {
  pub x: i32,
  pub y: i32,
}

implement Clone : Pair {
  fn clone(*const self) Self {
    Self { .x = self.x, .y = self.y }
  }
}

fn dup[T: Clone](v: T) T {
  return v.clone();
}

fn main() i32 {
  let p = Pair { .x = 1, .y = 2 };
  let q = dup(p);
  @println("{}", q.x + q.y);
  return 0;
}
