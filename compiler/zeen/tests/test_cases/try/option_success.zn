fn maybe(flag: bool, value: i32) Option[i32] {
  if (flag) {
    return Option.Some(value);
  }

  return Option.None;
}

fn add_one(flag: bool, value: i32) Option[i32] {
  let inner = maybe(flag, value)?;

  return Option.Some(inner + 1);
}

fn chained(flag: bool) Option[i32] {
  let first = add_one(flag, 10)?;
  let second = add_one(flag, first)?;

  return Option.Some(second);
}

fn main() {
  let ok = chained(true);
  let none = chained(false);

  switch (ok) {
    .Some(value) => @println("ok: {}", value),
    .None => @println("ok: none"),
  };

  switch (none) {
    .Some(value) => @println("none: {}", value),
    .None => @println("none: none"),
  };
}
