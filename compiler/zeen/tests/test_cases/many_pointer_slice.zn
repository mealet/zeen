fn main() {
  let a = @as([*]char, "hello");
  @println("{}", a[0..1]);
  @println("{}", a[..3]);
  @println("{}", a[1..4]);
  @println("{}", a[0..=1]);

  let c = @as([*]const char, "world")[0..2];
  @println("{}", c);

  let buf: [6]i32 = [104, 101, 108, 108, 111, 0];
  let p: [*]i32 = @as([*]i32, &buf[0]);
  p[1..3][0] = 121;
  @println("{}", buf[1]);
}
