interface Source {
    alias Item;

    pub fn read(*self) Item;
}

struct Celsius {
    degrees: i32,
}

implement Source : Celsius {
    alias Item = i32;

    fn read(*self) Item {
        return self.degrees;
    }
}

fn read_item[S: Source](source: *S) S.Item {
    return source.read();
}

fn main() {
    let celsius = Celsius { .degrees = 21 };

    @println("{}", read_item(&celsius));
}
