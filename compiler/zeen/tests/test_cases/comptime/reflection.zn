struct Point {
  x: i32,
  y: i64,
}

enum Shape {
  Empty,
  Circle: f64,
  Rect: {
    w: i32,
    h: i32,
  },
}

comptime Fields = @fields(Point);
comptime PointInfo = @typeInfo(Point);
comptime ShapeInfo = @typeInfo(Shape);
comptime HasX = @hasField(Point, "x");
comptime HasZ = @hasField(Point, "z");
comptime YType = @fieldType(Point, "y");

comptime fn dump_fields(T: zeen_type) void {
  for (f : @fields(T)) {
    @println("[$(f.index)] $(f.name): $(f.type)");
  }
}

comptime fn dump_variants(T: zeen_type) void {
  for (v : @variants(T)) {
    @println("[$(v.index)] $(v.name) $(v.payload)");
  }
}

fn main() {
  @println("{} {}", Fields[1].name, Fields[0].type);
  dump_fields(@zeen_type(Point));
  dump_variants(@zeen_type(Shape));
  @println("{} {}", PointInfo, ShapeInfo);
  @println("{} {}", HasX, HasZ);
  @println("{}", YType);
}
