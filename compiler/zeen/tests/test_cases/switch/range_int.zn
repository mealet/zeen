fn main() {
  let a = 5;
  let r = switch (a) {
    0..10 => 1,
    10..20 => 2,
    _ => 0,
  };
  @println("r: {}", r);

  let n = -7;
  let m = switch (n) {
    -10..-5 => 10,
    -5..5 => 20,
    _ => 30,
  };
  @println("m: {}", m);

  let o = switch (a) {
    ..0 => -1,
    ..=5 => 50,
    100.. => 101,
    _ => 102,
  };
  @println("o: {}", o);

  let g = switch (a) {
    v if (v > 100) => 1000,
    0..10 if (a == 5) => 2000,
    _ => 3000,
  };
  @println("g: {}", g);
}
