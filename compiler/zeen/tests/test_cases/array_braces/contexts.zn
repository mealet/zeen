struct Buffer {
  pub data: [2]i32,
  pub len: i32,
}

fn first(values: [2]i32) i32 {
  return values[0];
}

fn build() [3]i32 {
  return {7, 8, 9};
}

fn main() {
  let direct = first({4, 5});
  let built = build();
  let buffer: Buffer = .{ .data = {6, 7}, .len = 2 };
  let nested = {{1, 1}, {2, 2}};
  let flag = true;
  let chosen: [2]i32 = if (flag) {1, 2} else {3, 4};
  let selected: [2]i32 = switch (1) {
    1 => {5, 6},
    _ => {7, 8},
  };
  let text = @format("{} {}", built[0], nested[1][1]);

  @println("{} {} {} {}", direct, buffer.data[1], chosen[1], selected[0]);
  @println("{}", text);
}
