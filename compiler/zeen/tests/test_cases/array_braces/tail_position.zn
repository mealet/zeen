fn tail() [3]i32 {
  let base = 1;

  {base + 1, base + 2, base + 3}
}

fn repeat() [4]i32 {
  return {0; 4};
}

fn block_then_array() i32 {
  {
    let inner = 5;

    @println("block {}", inner);
  };

  return 6;
}

fn main() {
  let values = tail();
  let zeros = repeat();
  let value = block_then_array();

  @println("{} {}", values[2], zeros[3]);
  @println("{}", value);
}
