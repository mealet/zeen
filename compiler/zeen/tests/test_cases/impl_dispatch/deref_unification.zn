struct Holder[T] {
  value: T,

  pub fn new(value: T) Self {
    Self { .value = value }
  }
}

implement[T] Deref : Holder[T] {
  fn deref(*const self) T {
    self.value
  }
}

fn main() {
  let h = Holder.new(11);
  let p = Holder.new(Holder.new(22));

  @println("{}", *h);
  @println("{}", **p);
}
